---
// Hero scene from Figma node 14196:20376 ("Hero Section") plus the page-level
// backdrop layers (image 1, pixel arc, ph_planet decorations) that sit behind
// the navbar and phone mockup. Backdrop divs are absolutely positioned against
// the page shell, so this component must be rendered inside a `relative` container.

// Headline is split per letter for the typewriter reveal. Letters are grouped by
// word because each letter renders as an inline-block (transforms don't apply to
// inline boxes) and a bare run of them would let a line break fall mid-word.
//
// Every letter runs the same one-shot reveal (`type-in` in the style block)
// offset by its own delay, which is what makes them land one after another. The
// 48 letters here type once on load over 47 * 55ms = 2.6s and then hold — the
// animation never repeats, so nothing clears afterwards.
const headline = "You've tried to learn to code before. This time it sticks.";
const CHAR_STAGGER_MS = 55;
let charIndex = 0;
const headlineWords = headline.split(" ").map((word) => ({
  chars: [...word].map((char) => ({ char, delay: charIndex++ * CHAR_STAGGER_MS })),
}));
---

<!-- backdrop: night-sky photo with fade-to-black, pixel arc (dark mode) -->
<div class="pointer-events-none absolute inset-x-0 top-0 z-0 transition-opacity duration-500 light:opacity-0" aria-hidden="true">
  <div class="absolute left-1/2 top-0 ml-[50px] h-[1463px] w-[1882px] -translate-x-1/2">
    <!-- Largest above-the-fold image, so it is the LCP candidate on most viewports. -->
    <img src="/images/hero-bg.png" alt="" class="size-full object-cover" width="2000" height="1555" fetchpriority="high" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-b from-[rgba(0,0,0,0)] from-[57.28%] to-black"></div>
  </div>
  <div class="absolute left-1/2 top-[-733px] h-[1004px] w-[1157px] -translate-x-1/2">
    <div class="absolute" style="inset: -26.29% -22.82%;">
      <img src="/images/hero-pixel-arc.svg" alt="" class="block size-full" />
    </div>
  </div>
</div>

<!-- backdrop: light-mode hero (light mode only) — matches Figma "Landing 7":
     the night-sky photo inverted to dark-on-white leaves a faint tan starfield,
     and a warm peach glow peaks at top-center behind the nav. -->
<div class="pointer-events-none absolute inset-x-0 top-0 z-0 opacity-0 transition-opacity duration-500 light:opacity-100" aria-hidden="true">
  <div class="absolute left-1/2 top-0 ml-[50px] h-[1463px] w-[1882px] -translate-x-1/2">
    <img src="/images/hero-bg.png" alt="" class="hero-speckles size-full object-cover" width="2000" height="1555" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-b from-[rgba(255,255,255,0)] from-[42%] to-white"></div>
  </div>
  <div class="hero-light-glow absolute inset-x-0 top-0 h-[900px]"></div>
</div>

<!-- floating pixel planets (above the phone mockup, like in Figma)

     Three nested elements, one transform each, so none of them fight:
       .planet-anchor  absolute placement + the cursor-repel offset (JS)
       .planet         idle bob + rock (`translate`/`rotate` properties)
       .planet-spin    continuous 360 spin
     The repel deliberately sits on its own wrapper rather than on .planet:
     individual `translate`/`rotate` properties are applied BEFORE `transform`
     in the same element's matrix, so a repel written to .planet's `transform`
     would be rotated by the sway and push off-axis by up to 14deg. Nesting
     composes the two cleanly instead. -->
<div class="pointer-events-none absolute inset-x-0 top-0 z-20 hidden md:block" aria-hidden="true" data-planet-field>
  <span class="planet-anchor absolute top-[185px] block h-16 w-[63px]" style="left: calc(50% - 491px);">
    <span class="planet block size-full">
      <img src="/images/planet-4.png" alt="" class="planet-spin block size-full" />
    </span>
  </span>
  <span class="planet-anchor absolute top-[241px] block h-[60px] w-[57px]" style="left: calc(50% + 487px);">
    <span class="planet block size-full" style="animation-delay: -0.43s;">
      <img src="/images/planet-3.png" alt="" class="planet-spin block size-full" style="animation-delay: -1.2s;" />
    </span>
  </span>
  <span class="planet-anchor absolute top-[646px] block size-20" style="left: calc(50% - 588px);">
    <span class="planet block size-full" style="animation-delay: -0.86s;">
      <img src="/images/planet-1.png" alt="" class="planet-spin block size-full" style="animation-delay: -2.4s;" />
    </span>
  </span>
  <span class="planet-anchor absolute top-[630px] block size-[89px]" style="left: calc(50% + 532px);">
    <span class="planet block size-full" style="animation-delay: -0.21s;">
      <img src="/images/planet-2.png" alt="" class="planet-spin block size-full" style="animation-delay: -3.6s;" />
    </span>
  </span>
</div>

<!-- hero content -->
<section class="relative z-10 mx-auto mt-24 flex w-full max-w-[856px] flex-col items-center gap-12 px-4 lg:mt-[144px]">
  <div class="flex w-full flex-col items-center gap-8">
    <div
      class="flex items-center justify-center gap-2.5 rounded-[32px] border border-[rgba(88,13,0,0.5)] bg-[rgba(7,0,0,0.5)] px-4 py-2 light:border-[rgba(220,140,60,0.4)] light:bg-[#fdf5ec] light:shadow-[0_4px_20px_rgba(255,149,45,0.12)] sm:gap-4 sm:px-6"
    >
      <img src="/images/hero-badge-dot.svg" alt="" class="size-2 shrink-0 light:brightness-0" />
      <p class="font-pixel text-center text-[16px] uppercase leading-[1.7] tracking-[1.5px] text-[#dedddd] light:text-black sm:text-[20px] sm:tracking-[3px]">
        Programming Hero is now <span class="text-[#ff952d]">Fibu</span>
      </p>
      <img src="/images/hero-badge-dot.svg" alt="" class="size-2 shrink-0 light:brightness-0" />
    </div>

    <div class="flex w-full flex-col gap-4 text-center">
      <h1
        class="hero-headline font-pixel text-[40px] uppercase leading-[0.9] text-white light:text-[#1c1512] sm:text-[52px] md:text-[68px] lg:text-[76px]"
        aria-label={headline}
      >
        {
          headlineWords.map((word, w) => (
            <>
              <span class="hero-word" aria-hidden="true">
                {word.chars.map(({ char, delay }) => (
                  <span class="hero-char" style={`animation-delay: ${delay}ms`}>{char}</span>
                ))}
              </span>
              {w < headlineWords.length - 1 ? " " : ""}
            </>
          ))
        }
      </h1>
      <p class="text-[18px] leading-[1.7] text-[#9e9e9e] light:text-[#525252]">
        Fibu turns coding into a daily habit you actually want to keep — 15 minutes at a time, guided
        by fibu and backed up by Grandma, the character our own users thank in their reviews
      </p>
    </div>
  </div>

  <div class="flex flex-wrap items-center justify-center gap-4">
    <a
      href="#google-play"
      class="relative block h-12 w-[162px] overflow-clip rounded-[5px] border-[1.2px] border-[#a6a6a6] bg-white transition-transform hover:scale-[1.03]"
      aria-label="Get it on Google Play"
    >
      <span class="absolute" style="left: 10.77px; top: 7.8px; width: 27.708px; height: 32.4px;">
        <img src="/images/badge-google-play-logo.svg" alt="" class="block size-full" />
      </span>
      <span class="absolute" style="left: 48.42px; top: 7.45px; width: 46.617px; height: 7.9px;">
        <img src="/images/badge-get-it-on.svg" alt="" class="block size-full" />
      </span>
      <span class="absolute" style="left: 48.05px; top: 20.28px; width: 101.731px; height: 21.45px;">
        <img src="/images/badge-google-play-text.svg" alt="" class="block size-full" />
      </span>
    </a>

    <a
      href="#app-store"
      class="relative block h-12 w-36 rounded-[7px] border-[1.2px] border-[#a6a6a6] bg-white transition-transform hover:scale-[1.03]"
      aria-label="Download on the App Store"
    >
      <span class="absolute" style="left: 10.77px; top: 9.78px; width: 21.26px; height: 27.44px;">
        <img src="/images/badge-apple-logo.svg" alt="" class="block size-full" />
      </span>
      <span class="absolute" style="left: 41.58px; top: 9.4px; width: 82.982px; height: 8.04px;">
        <img src="/images/badge-download-on-the.svg" alt="" class="block size-full" />
      </span>
      <span class="absolute" style="left: 40.14px; top: 21.2px; width: 90.092px; height: 19.81px;">
        <img src="/images/badge-app-store-text.svg" alt="" class="block size-full" />
      </span>
    </a>
  </div>
</section>

<style>
  /* Light-mode hero wash — matches Figma "Landing 7". Peak peach at top-center
     is rgb(254,203,153) = rgba(255,149,45,0.5) over white; it fades to white by
     ~±500px horizontally and ~450px down. Pixel-sampled from the Figma render. */
  /* Night-sky photo inverted to near-white with faint dark speckles (the tan
     starfield in Figma's light hero). filter:invert is backdrop-independent, so
     it survives the backdrop's isolating stacking context. */
  .hero-speckles {
    opacity: 0.28;
    filter: invert(1);
  }

  /* Headline types one letter at a time on load and then holds the full line.
     Each word is an inline-block so a line break can only land between words,
     never between two letters. */
  .hero-word {
    display: inline-block;
  }

  /* Each letter is held hidden through its own stagger delay by the backwards
     fill, then strikes and stays. The animation itself is instant, so the
     letter cuts in the way a typewriter strikes rather than fading.
     Deliberately NOT `forwards`/`both`: with no forwards fill the resting state
     is the letter's own (opaque) style instead of a keyframe value, so nothing
     depends on the animation's progress landing exactly on 1. It doesn't —
     over a 1ms duration the delay/duration division loses enough precision that
     progress tops out around 0.99999999999989, and a `steps()` easing would
     floor that back to the hidden keyframe and strand the letter forever. */
  .hero-char {
    display: inline-block;
    animation: type-in 1ms backwards;
  }

  /* No `to`: the end value is the letter's own opacity, i.e. fully visible. */
  @keyframes type-in {
    from {
      opacity: 0;
    }
  }

  .hero-light-glow {
    background:
      radial-gradient(
        850px 560px at 50% -30px,
        rgba(255, 149, 45, 0.5) 0%,
        rgba(255, 149, 45, 0.3) 20%,
        rgba(255, 149, 45, 0.12) 45%,
        rgba(255, 149, 45, 0.04) 68%,
        transparent 88%
      );
  }

  /* Carries only the cursor-repel offset, written by the script below as a
     `transform`. The transition is what makes the planet drift out of the
     cursor's way and settle back home instead of snapping — it covers both
     directions, so the return needs no separate handling. */
  .planet-anchor {
    transition: transform 0.3s ease-out;
    will-change: transform;
  }

  /* Two rotations can't share one element (the later animation would win the
     `rotate` property), so the wrapper does the bob + left-right rock and the
     image inside does the continuous 360° spin. `translate`/`rotate` are used
     as individual transform properties so the bob and the rock compose. */
  .planet {
    animation:
      float 1.5s ease-in-out infinite,
      sway 2s ease-in-out infinite;
  }

  .planet-spin {
    animation: spin-round 6s linear infinite;
  }

  @keyframes float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -12px;
    }
  }

  @keyframes sway {
    0%,
    100% {
      rotate: -14deg;
    }
    50% {
      rotate: 14deg;
    }
  }

  @keyframes spin-round {
    from {
      rotate: 0deg;
    }
    to {
      rotate: 360deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .planet,
    .planet-spin,
    .hero-char {
      animation: none;
    }

    /* The script opts out entirely under reduced motion; this is the belt-and-
       braces half, so nothing animates even if a transform were ever set. */
    .planet-anchor {
      transition: none;
    }
  }
</style>

<script>
  // Cursor repel: planets drift out of the way as the pointer nears them, then
  // ease back once it leaves. The offset is written to .planet-anchor's
  // `transform`; the idle bob/rock/spin live on the nested elements and are
  // never touched, so the two compose instead of overwriting each other.

  /** Distance at which a planet starts reacting. */
  const RADIUS = 180;
  /** Offset at the point of closest approach. */
  const MAX_PUSH = 90;
  /** How close a pushed planet may get to the viewport edge. */
  const EDGE_MARGIN = 8;

  const field = document.querySelector<HTMLElement>('[data-planet-field]');

  // Pointless on touch (no hovering cursor to flee), and unwanted when the
  // visitor has asked for less motion.
  const wantsMotion =
    matchMedia('(hover: hover) and (pointer: fine)').matches &&
    !matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (field && wantsMotion) {
    const planets = [...field.querySelectorAll<HTMLElement>('.planet-anchor')].map((el) => ({
      el,
      // Resting centre in document space, filled in by measure().
      cx: 0,
      cy: 0,
      // Half the layout box, so the clamp can reason about the planet's edges.
      hw: 0,
      hh: 0,
      // Offset currently written to the DOM.
      x: 0,
      y: 0,
    }));

    // Viewport size, cached alongside the centres — only a resize changes it.
    let viewW = 0;
    let viewH = 0;

    let pointerX = 0;
    let pointerY = 0;
    // Two independent rAF handles: sharing one would let a pending re-measure
    // swallow the next pointer frame, and the effect would stop dead.
    let frame = 0;
    let measureFrame = 0;

    /**
     * Resting centre of each planet, in document coordinates.
     *
     * Walks offsetParent rather than using getBoundingClientRect: offset* are
     * layout values, so they ignore both the repel transform we just wrote and
     * the idle bob/rock. A rect would fold all of that in and feed our own
     * output back into the next frame's input.
     */
    const measure = () => {
      for (const planet of planets) {
        let x = 0;
        let y = 0;

        for (let node: HTMLElement | null = planet.el; node; node = node.offsetParent as HTMLElement | null) {
          x += node.offsetLeft;
          y += node.offsetTop;
        }

        planet.hw = planet.el.offsetWidth / 2;
        planet.hh = planet.el.offsetHeight / 2;
        planet.cx = x + planet.hw;
        planet.cy = y + planet.hh;
      }

      viewW = document.documentElement.clientWidth;
      viewH = document.documentElement.clientHeight;
    };

    const apply = () => {
      frame = 0;

      const scrollX = window.scrollX;
      const scrollY = window.scrollY;
      const mouseX = pointerX + scrollX;
      const mouseY = pointerY + scrollY;

      for (const planet of planets) {
        // Vector from cursor to planet — the direction it should flee.
        const dx = planet.cx - mouseX;
        const dy = planet.cy - mouseY;
        const distance = Math.hypot(dx, dy);

        let tx = 0;
        let ty = 0;

        // The `> 0` guard keeps a cursor exactly on centre from dividing by zero.
        if (distance < RADIUS && distance > 0) {
          const push = (1 - distance / RADIUS) * MAX_PUSH;
          tx = (dx / distance) * push;
          ty = (dy / distance) * push;

          // A 90px shove is enough to carry a planet off the edge on a narrower
          // window — at 1024px the top-left planet rests about 20px from the
          // left. Clamp so it can slide up to the margin and stop there, which
          // reads as the planet hugging the edge rather than escaping the page.
          //
          // `Math.min(edge, MARGIN)` is what keeps this from *fixing* the
          // layout: planets that already rest off-screen at narrow widths stay
          // exactly where the design puts them instead of being dragged inward.
          const left = planet.cx - scrollX - planet.hw;
          const right = planet.cx - scrollX + planet.hw;
          const top = planet.cy - scrollY - planet.hh;
          const bottom = planet.cy - scrollY + planet.hh;

          tx = Math.min(Math.max(tx, Math.min(left, EDGE_MARGIN) - left), Math.max(right, viewW - EDGE_MARGIN) - right);
          ty = Math.min(Math.max(ty, Math.min(top, EDGE_MARGIN) - top), Math.max(bottom, viewH - EDGE_MARGIN) - bottom);
        }

        const atRest = tx === 0 && ty === 0;
        const wasAtRest = planet.x === 0 && planet.y === 0;

        // Skip writes nobody can see, but always write the frame that returns a
        // planet to exactly zero so it does not strand a fraction of a pixel out.
        if (atRest && wasAtRest) continue;
        if (!atRest && Math.abs(tx - planet.x) < 0.5 && Math.abs(ty - planet.y) < 0.5) continue;

        planet.x = tx;
        planet.y = ty;
        planet.el.style.transform = atRest ? '' : `translate(${tx.toFixed(2)}px, ${ty.toFixed(2)}px)`;
      }
    };

    const onPointerMove = (event: MouseEvent) => {
      pointerX = event.clientX;
      pointerY = event.clientY;
      // Coalesce bursts of mousemove into one write per frame.
      if (!frame) frame = requestAnimationFrame(apply);
    };

    const onResize = () => {
      if (measureFrame) return;
      measureFrame = requestAnimationFrame(() => {
        measureFrame = 0;
        measure();
      });
    };

    let listening = false;

    const start = () => {
      if (listening) return;
      listening = true;
      measure();
      window.addEventListener('mousemove', onPointerMove, { passive: true });
      window.addEventListener('resize', onResize, { passive: true });
    };

    const stop = () => {
      if (!listening) return;
      listening = false;
      window.removeEventListener('mousemove', onPointerMove);
      window.removeEventListener('resize', onResize);

      if (frame) {
        cancelAnimationFrame(frame);
        frame = 0;
      }

      if (measureFrame) {
        cancelAnimationFrame(measureFrame);
        measureFrame = 0;
      }

      // Send everything home, so a planet is never frozen mid-push off-screen.
      for (const planet of planets) {
        planet.x = 0;
        planet.y = 0;
        planet.el.style.transform = '';
      }
    };

    // Nothing is listening while the hero is off-screen, so scrolling the rest
    // of the page costs exactly nothing. This also covers the `hidden md:block`
    // case: a display:none container never reports as intersecting.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) start();
          else stop();
        }
      },
      { rootMargin: '100px' },
    );

    observer.observe(field);
  }
</script>
