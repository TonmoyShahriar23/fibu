---
// Hero scene from Figma node 14196:20376 ("Hero Section") plus the page-level
// backdrop layers (image 1, pixel arc, ph_planet decorations) that sit behind
// the navbar and phone mockup. Backdrop divs are absolutely positioned against
// <main>, so this component must be rendered inside a `relative` container.

// Headline is split per letter for the typewriter loop. Letters are grouped by
// word because each letter renders as an inline-block (transforms don't apply to
// inline boxes) and a bare run of them would let a line break fall mid-word.
//
// Every letter runs the same infinite cycle (`--type-cycle` in the style block)
// offset by its own delay, which is what makes them land one after another. The
// 48 letters here span 47 * 55ms = 2.6s of typing, and the cycle's trailing
// hidden phase (38% of 9s = 3.4s) is longer than that, so the first letter never
// retypes while the last is still clearing. Raising the stagger or the headline
// length means raising the cycle to match.
const headline = "You've tried to learn to code before. This time it sticks.";
const CHAR_STAGGER_MS = 55;
let charIndex = 0;
const headlineWords = headline.split(" ").map((word) => ({
  chars: [...word].map((char) => ({ char, delay: charIndex++ * CHAR_STAGGER_MS })),
}));
---

<!-- backdrop: night-sky photo with fade-to-black, pixel arc (dark mode) -->
<div class="pointer-events-none absolute inset-x-0 top-0 z-0 transition-opacity duration-500 light:opacity-0" aria-hidden="true">
  <div class="absolute left-1/2 top-0 ml-[50px] h-[1463px] w-[1882px] -translate-x-1/2">
    <img src="/images/hero-bg.png" alt="" class="size-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-b from-[rgba(0,0,0,0)] from-[57.28%] to-black"></div>
  </div>
  <div class="absolute left-1/2 top-[-733px] h-[1004px] w-[1157px] -translate-x-1/2">
    <div class="absolute" style="inset: -26.29% -22.82%;">
      <img src="/images/hero-pixel-arc.svg" alt="" class="block size-full" />
    </div>
  </div>
</div>

<!-- backdrop: light-mode hero (light mode only) — matches Figma "Landing 7":
     the night-sky photo inverted to dark-on-white leaves a faint tan starfield,
     and a warm peach glow peaks at top-center behind the nav. -->
<div class="pointer-events-none absolute inset-x-0 top-0 z-0 opacity-0 transition-opacity duration-500 light:opacity-100" aria-hidden="true">
  <div class="absolute left-1/2 top-0 ml-[50px] h-[1463px] w-[1882px] -translate-x-1/2">
    <img src="/images/hero-bg.png" alt="" class="hero-speckles size-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-b from-[rgba(255,255,255,0)] from-[42%] to-white"></div>
  </div>
  <div class="hero-light-glow absolute inset-x-0 top-0 h-[900px]"></div>
</div>

<!-- floating pixel planets (above the phone mockup, like in Figma) -->
<div class="pointer-events-none absolute inset-x-0 top-0 z-20 hidden md:block" aria-hidden="true">
  <span class="planet absolute top-[185px] block h-16 w-[63px]" style="left: calc(50% - 491px);">
    <img src="/images/planet-4.png" alt="" class="planet-spin block size-full" />
  </span>
  <span class="planet absolute top-[241px] block h-[60px] w-[57px]" style="left: calc(50% + 487px); animation-delay: -0.43s;">
    <img src="/images/planet-3.png" alt="" class="planet-spin block size-full" style="animation-delay: -1.2s;" />
  </span>
  <span class="planet absolute top-[646px] block size-20" style="left: calc(50% - 588px); animation-delay: -0.86s;">
    <img src="/images/planet-1.png" alt="" class="planet-spin block size-full" style="animation-delay: -2.4s;" />
  </span>
  <span class="planet absolute top-[630px] block size-[89px]" style="left: calc(50% + 532px); animation-delay: -0.21s;">
    <img src="/images/planet-2.png" alt="" class="planet-spin block size-full" style="animation-delay: -3.6s;" />
  </span>
</div>

<!-- hero content -->
<section class="relative z-10 mx-auto mt-24 flex w-full max-w-[856px] flex-col items-center gap-12 px-4 lg:mt-[144px]">
  <div class="flex w-full flex-col items-center gap-8">
    <div
      class="flex items-center justify-center gap-2.5 rounded-[32px] border border-[rgba(88,13,0,0.5)] bg-[rgba(7,0,0,0.5)] px-4 py-2 light:border-[rgba(220,140,60,0.4)] light:bg-[#fdf5ec] light:shadow-[0_4px_20px_rgba(255,149,45,0.12)] sm:gap-4 sm:px-6"
    >
      <img src="/images/hero-badge-dot.svg" alt="" class="size-2 shrink-0 light:brightness-0" />
      <p class="font-pixel text-center text-[16px] uppercase leading-[1.7] tracking-[1.5px] text-[#dedddd] light:text-black sm:text-[20px] sm:tracking-[3px]">
        Programming Hero is now <span class="text-[#ff952d]">Fibu</span>
      </p>
      <img src="/images/hero-badge-dot.svg" alt="" class="size-2 shrink-0 light:brightness-0" />
    </div>

    <div class="flex w-full flex-col gap-4 text-center">
      <h1
        class="hero-headline font-pixel text-[40px] uppercase leading-[0.9] text-white light:text-[#1c1512] sm:text-[52px] md:text-[68px] lg:text-[76px]"
        aria-label={headline}
      >
        {
          headlineWords.map((word, w) => (
            <>
              <span class="hero-word" aria-hidden="true">
                {word.chars.map(({ char, delay }) => (
                  <span class="hero-char" style={`animation-delay: ${delay}ms`}>{char}</span>
                ))}
              </span>
              {w < headlineWords.length - 1 ? " " : ""}
            </>
          ))
        }
      </h1>
      <p class="text-[18px] leading-[1.7] text-[#9e9e9e] light:text-[#525252]">
        Fibu turns coding into a daily habit you actually want to keep — 15 minutes at a time, guided
        by fibu and backed up by Grandma, the character our own users thank in their reviews
      </p>
    </div>
  </div>

  <div class="flex flex-wrap items-center justify-center gap-4">
    <a
      href="#google-play"
      class="relative block h-12 w-[162px] overflow-clip rounded-[5px] border-[1.2px] border-[#a6a6a6] bg-white transition-transform hover:scale-[1.03]"
      aria-label="Get it on Google Play"
    >
      <span class="absolute" style="left: 10.77px; top: 7.8px; width: 27.708px; height: 32.4px;">
        <img src="/images/badge-google-play-logo.svg" alt="" class="block size-full" />
      </span>
      <span class="absolute" style="left: 48.42px; top: 7.45px; width: 46.617px; height: 7.9px;">
        <img src="/images/badge-get-it-on.svg" alt="" class="block size-full" />
      </span>
      <span class="absolute" style="left: 48.05px; top: 20.28px; width: 101.731px; height: 21.45px;">
        <img src="/images/badge-google-play-text.svg" alt="" class="block size-full" />
      </span>
    </a>

    <a
      href="#app-store"
      class="relative block h-12 w-36 rounded-[7px] border-[1.2px] border-[#a6a6a6] bg-white transition-transform hover:scale-[1.03]"
      aria-label="Download on the App Store"
    >
      <span class="absolute" style="left: 10.77px; top: 9.78px; width: 21.26px; height: 27.44px;">
        <img src="/images/badge-apple-logo.svg" alt="" class="block size-full" />
      </span>
      <span class="absolute" style="left: 41.58px; top: 9.4px; width: 82.982px; height: 8.04px;">
        <img src="/images/badge-download-on-the.svg" alt="" class="block size-full" />
      </span>
      <span class="absolute" style="left: 40.14px; top: 21.2px; width: 90.092px; height: 19.81px;">
        <img src="/images/badge-app-store-text.svg" alt="" class="block size-full" />
      </span>
    </a>
  </div>
</section>

<style>
  /* Light-mode hero wash — matches Figma "Landing 7". Peak peach at top-center
     is rgb(254,203,153) = rgba(255,149,45,0.5) over white; it fades to white by
     ~±500px horizontally and ~450px down. Pixel-sampled from the Figma render. */
  /* Night-sky photo inverted to near-white with faint dark speckles (the tan
     starfield in Figma's light hero). filter:invert is backdrop-independent, so
     it survives the backdrop's isolating stacking context. */
  .hero-speckles {
    opacity: 0.28;
    filter: invert(1);
  }

  /* Headline types one letter at a time, holds the full line, clears, repeats.
     Each word is an inline-block so a line break can only land between words,
     never between two letters. */
  .hero-headline {
    --type-cycle: 9s;
  }

  .hero-word {
    display: inline-block;
  }

  /* steps(1, end) holds each keyframe's value until the next one, so letters cut
     in and out instantly the way a typewriter strikes rather than fading.
     `both` matters: without it a letter would sit visible through its delay and
     then blink off when its animation finally started. */
  .hero-char {
    display: inline-block;
    animation: type-loop var(--type-cycle) steps(1, end) infinite both;
  }

  /* 0-2%: waiting to be struck. 2%: appears. 62%: clears for the next pass. */
  @keyframes type-loop {
    0% {
      opacity: 0;
    }
    2% {
      opacity: 1;
    }
    62% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  .hero-light-glow {
    background:
      radial-gradient(
        850px 560px at 50% -30px,
        rgba(255, 149, 45, 0.5) 0%,
        rgba(255, 149, 45, 0.3) 20%,
        rgba(255, 149, 45, 0.12) 45%,
        rgba(255, 149, 45, 0.04) 68%,
        transparent 88%
      );
  }

  /* Two rotations can't share one element (the later animation would win the
     `rotate` property), so the wrapper does the bob + left-right rock and the
     image inside does the continuous 360° spin. `translate`/`rotate` are used
     as individual transform properties so the bob and the rock compose. */
  .planet {
    animation:
      float 1.5s ease-in-out infinite,
      sway 2s ease-in-out infinite;
  }

  .planet-spin {
    animation: spin-round 6s linear infinite;
  }

  @keyframes float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -12px;
    }
  }

  @keyframes sway {
    0%,
    100% {
      rotate: -14deg;
    }
    50% {
      rotate: 14deg;
    }
  }

  @keyframes spin-round {
    from {
      rotate: 0deg;
    }
    to {
      rotate: 360deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .planet,
    .planet-spin,
    .hero-char {
      animation: none;
    }
  }
</style>
