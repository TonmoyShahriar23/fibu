---
import CommunityOrbit from './CommunityOrbit.astro';
import Connector from './Connector.astro';

// Figma nodes: 14196:26572 (problem heading + cards), 14196:26564/26565 et al.
// (connector curves, stroke #2C2A2A), 14196:27174 (app icon), 14196:27217
// (solution heading), 14196:26797 (solution cards). Page rhythm: stats →120px→
// problem section →280px connector zone→ 120px icon →176px→ heading →40px→ cards.
const problems = [
  {
    title: 'It read like a textbook',
    body: "40 videos in, and you still can't write a for-loop from memory.",
  },
  {
    title: "You couldn't see yourself improving",
    body: 'No visible progress kills motivation by day 3.',
  },
  {
    title: 'You were learning completely alone',
    body: 'No one to high-five you when you finally fixed that bug.',
  },
];
---

<!-- `js-motion` (the flag that gates the off-screen start state below) is set in
     Layout's head script, ahead of any of this being painted. -->
<section class="relative z-10 mx-auto w-full max-w-[1224px] px-4">
  <!-- ======================= problem ======================= -->
  <div class="mt-[120px] flex flex-col items-center gap-[52px]">
    <h2
      id="problem-heading"
      class="heading-gradient font-pixel max-w-[624px] text-center text-[32px] uppercase leading-[0.9] sm:text-[44px] lg:text-[64px]"
    >
      Here's why your last coding app didn't work out
    </h2>

    <!-- The outer cards fly in from beyond the viewport edges while the middle
         one flips into place; the page shell's overflow-x-clip absorbs the travel. -->
    <div id="problem-cards" class="grid w-full grid-cols-1 gap-6 md:grid-cols-3">
      <!-- card 1: textbook fox -->
      <article class="card-shell reveal reveal-from-left">
        <div class="card-copy">
          <h3 class="font-pixel text-[40px] leading-[0.95] text-white light:text-[#1c1512]">{problems[0].title}</h3>
          <p class="text-[16px] leading-[1.5] text-[#dedddd] light:text-[#525252]">{problems[0].body}</p>
        </div>
        <div class="absolute left-[calc(50%-14px)] top-[146px] h-[392px] w-[362px] -translate-x-1/2">
          <span class="absolute" style="inset: 4.08% 8.29% 4.08% -0.28%;">
            <img src="/images/card-fox-textbook.svg" alt="" class="block size-full" loading="lazy" />
          </span>
        </div>
      </article>

      <!-- card 2: frustrated fox + crossed-out doc -->
      <article class="card-shell reveal reveal-flip">
        <div class="card-copy">
          <h3 class="font-pixel text-[40px] leading-none text-white light:text-[#1c1512]">{problems[1].title}</h3>
          <p class="text-[16px] leading-[1.5] text-[#dedddd] light:text-[#525252]">{problems[1].body}</p>
        </div>
        <img
          src="/images/card-fox-frustrated.svg"
          alt=""
          class="absolute left-[43px] top-[190px] h-[309px] w-[230px]"
          loading="lazy"
        />
        <img
          src="/images/card-doc-stamp.png"
          alt=""
          class="absolute left-[237px] top-[310px] size-[101px]"
          loading="lazy"
        />
      </article>

      <!-- card 3: fox reading alone -->
      <article class="card-shell reveal reveal-from-right">
        <div class="card-copy">
          <h3 class="font-pixel text-[40px] leading-none text-white light:text-[#1c1512]">{problems[2].title}</h3>
          <p class="text-[16px] leading-[1.5] text-[#dedddd] light:text-[#525252]">{problems[2].body}</p>
        </div>
        <img
          src="/images/card-fox-alone.svg"
          alt=""
          class="absolute left-[36px] top-[196px] h-[306px] w-[320px]"
          loading="lazy"
        />
      </article>
    </div>
  </div>

  <!-- ===== connector: the three problem cards converge into the fibu icon ===== -->
  <!-- All three nodes start together and land on the hub in the same frame; the
       outbound wires below only fire once they've arrived. -->
  <div class="relative hidden h-[280px] md:block" aria-hidden="true" style="color: var(--connector);">
    <Connector id="wire-in-right" class="left-1/2 w-[428px]" />
    <Connector id="wire-in-left" class="w-[428px] -scale-x-100" style="left: calc(50% - 428px);" />
    <!-- straight drop from the middle card; the box is 40px wide so the node has
         room to render — a 1px-wide viewport would squash it away -->
    <Connector
      id="wire-in-middle"
      d="M20 0V280"
      viewBox="0 0 40 280"
      class="left-1/2 w-10 -translate-x-1/2"
    />
  </div>

  <!-- fibu app icon: the pinch point of the hourglass -->
  <div class="mt-10 flex justify-center md:mt-0">
    <img src="/images/app-icon.png" alt="Fibu app icon" class="size-[120px] rounded-[24px]" loading="lazy" />
  </div>

  <!-- ===== solution: the icon fans back out; heading nested in the lower flare ===== -->
  <!-- flow-root keeps the heading's original top margin from collapsing, so the
       connector below still anchors to the icon while every block keeps its size -->
  <div id="solution" class="relative flow-root">
    <!-- diverging connector: icon → the three solution cards -->
    <!-- The -scale-y-100 flip puts the hub at the path's END, so travel is
         reversed to keep the node flowing outward from the icon. These run in
         the second half of the cycle — they leave only once the three inbound
         nodes have landed on the hub. -->
    <div
      class="solution-wires pointer-events-none absolute inset-x-0 top-0 hidden h-[280px] md:block"
      aria-hidden="true"
      style="color: var(--connector);"
    >
      <Connector id="wire-out-right" class="left-1/2 w-[428px] -scale-y-100" reverse phase="second" />
      <Connector
        id="wire-out-left"
        class="w-[428px] -scale-x-100 -scale-y-100"
        style="left: calc(50% - 428px);"
        reverse
        phase="second"
      />
      <!-- Straight drop from the icon, through the heading, down to the middle
           solution card — the mirror of wire-in-middle above the hub, so the
           middle column is wired on both legs instead of only the inbound one.
           This is also the wire whose node dims as it crosses the heading. -->
      <Connector
        id="wire-out-middle"
        d="M20 0V280"
        viewBox="0 0 40 280"
        class="left-1/2 w-10 -translate-x-1/2"
        phase="second"
        dim
      />
    </div>

    <h2
      class="heading-gradient font-pixel relative mx-auto mt-[100px] max-w-[552px] text-center text-[32px] uppercase leading-none sm:text-[44px] md:mt-[176px] lg:text-[64px]"
    >
      The Solution (Meet fibu)
    </h2>

    <div class="relative mt-10 grid w-full grid-cols-1 gap-6 md:grid-cols-3">
      <!-- card A: code editor -->
      <article class="card-shell solution-card">
        <div class="card-copy">
          <h3 class="font-pixel text-[40px] leading-[0.95] text-white light:text-[#1c1512]">Build real things, in bites</h3>
          <p class="text-[16px] leading-[1.5] text-[#dedddd] light:text-[#525252]">
            10–15 minute daily missions. No lectures, no walls of text.
          </p>
        </div>

        <div
          class="absolute left-1/2 top-[189px] flex w-[342px] max-w-[calc(100%-24px)] -translate-x-1/2 flex-col gap-2 rounded-[12px] border border-[rgba(128,128,128,0.2)] bg-[rgba(123,123,123,0.1)] p-2 light:border-[rgba(0,0,0,0.1)] light:bg-[#ececec]"
        >
          <div class="flex items-center gap-4 pl-2">
            <img src="/images/editor-traffic-dots.svg" alt="" class="h-2 w-10" loading="lazy" />
            <p class="font-dm-mono text-[14px] leading-[22px] text-[#606060]">console.js</p>
          </div>
          <div class="relative h-[173px] w-[326px] max-w-full">
            <img src="/images/editor-panel-bg.svg" alt="" class="absolute inset-0 size-full light:hidden" loading="lazy" />
            <img src="/images/editor-panel-bg-light.svg" alt="" class="absolute inset-0 hidden size-full light:block" loading="lazy" />
            <div
              class="absolute left-[139px] top-0 flex h-8 items-center rounded-[6px] bg-[#171717] px-4 py-2 light:bg-[#e4e4e4]"
            >
              <p class="font-dm-mono whitespace-nowrap text-[14px] leading-[18px] text-[#9e9e9e] light:text-[#606060]">Browser</p>
            </div>
            <div class="absolute left-4 top-[6px] flex items-center justify-center gap-2">
              <img src="/images/icon-html5.svg" alt="" class="size-4" loading="lazy" />
              <p class="font-dm-mono whitespace-nowrap text-[14px] leading-[22px] text-[#9e9e9e] light:text-[#606060]">Index.html</p>
            </div>
            <div class="absolute left-1/2 top-[49px] flex w-[302px] -translate-x-1/2 flex-col gap-2">
              <div class="font-dm-mono flex items-start gap-4 whitespace-nowrap py-1 pl-3 text-[16px] leading-[22px]">
                <p class="text-[#606060]">1</p>
                <p class="text-[#dedddd] light:text-[#1c1512]">{'function multiply(a, b) {'}</p>
              </div>
              <div
                class="flex items-start justify-between rounded-[8px] border-l border-[#e90000] bg-[#171616] py-1 pl-3 pr-1 light:bg-[#e6e6e6]"
              >
                <div class="flex items-center gap-4">
                  <p class="font-dm-mono text-[16px] leading-[22px] text-[#f4f4f4] light:text-[#1c1512]">2</p>
                  <!-- Typed text and caret sit in their own box so the caret
                       tracks the last character. The line renders empty, so
                       with the text stripped out the caret lands exactly where
                       the design's static one was. -->
                  <div class="flex items-center">
                    <p
                      id="code-line"
                      class="font-dm-mono whitespace-nowrap text-[16px] leading-[22px] text-[#dedddd] light:text-[#1c1512]"
                      data-code="return a * b;"
                    >
                    </p>
                    <span class="code-caret h-4 w-px bg-[#f4f4f4] light:bg-[#1c1512]"></span>
                  </div>
                </div>
                <img src="/images/icon-eraser.svg" alt="" class="size-6 light:invert" loading="lazy" />
              </div>
              <div class="font-dm-mono flex items-start gap-4 whitespace-nowrap py-1 pl-3 text-[16px] leading-[22px]">
                <p class="text-[#606060]">3</p>
                <p class="text-[#9e9e9e] light:text-[#606060]">{'}'}</p>
              </div>
            </div>
            <img src="/images/icon-copy.svg" alt="" class="absolute right-0 top-1 size-6" loading="lazy" />
          </div>
        </div>
      </article>

      <!-- card B: streak calendars + flame -->
      <article id="streak-card" class="card-shell solution-card">
        <div class="card-copy">
          <h3 class="font-pixel text-[40px] leading-[0.95] text-white light:text-[#1c1512]">Progress you can actually see</h3>
          <p class="text-[16px] leading-[1.5] text-[#dedddd] light:text-[#525252]">
            XP, streaks, badges, levels — every session ends with proof you improved
          </p>
        </div>
        <img
          src="/images/streak-glow.svg"
          alt=""
          class="streak-glow absolute left-[calc(50%-7px)] top-[51.52%] w-[211px] -translate-x-1/2 mix-blend-lighten"
          style="height: 59.5%;"
          loading="lazy"
        />
        <img
          src="/images/streak-calendar-stack.png"
          alt=""
          class="absolute left-1/2 top-[143px] w-[384px] max-w-none -translate-x-1/2 light:hidden"
          width="384"
          height="203"
          loading="lazy"
          decoding="async"
        />
        <img
          src="/images/streak-calendar-stack-light.png"
          alt=""
          class="absolute left-1/2 top-[143px] hidden w-[384px] max-w-none -translate-x-1/2 light:block"
          width="384"
          height="199"
          loading="lazy"
          decoding="async"
        />

        <!-- The three earned days. The calendar art behind carries the unlit
             glyph for all seven, so these only ever have to light up on top of
             it — same 384px box and centring as that art, so they land on their
             own cells at every card width. Lit is the default state: the
             stagger below only holds them back when JS is there to release
             them. -->
        <div
          class="pointer-events-none absolute left-1/2 top-[258px] h-6 w-[384px] max-w-none -translate-x-1/2"
          aria-hidden="true"
        >
          {
            [39, 87, 135].map((left, day) => (
              <img
                src="/images/streak-flame-day.svg"
                alt=""
                class="streak-day absolute top-0 h-6 w-[18px]"
                style={`left: ${left}px; --day: ${day};`}
                loading="lazy"
              />
            ))
          }
        </div>

        <div
          class="absolute left-[calc(50%-7px)] top-[335px] h-[166px] w-32 -translate-x-1/2 overflow-clip drop-shadow-[0px_4px_2px_rgba(0,0,0,0.25)]"
        >
          <span class="absolute" style="inset: 10.84% 12.5% 12.05% 12.5%;">
            <span class="absolute" style="inset: -15.63% -20.83%;">
              <img src="/images/streak-flame-big.svg" alt="" class="streak-flame block size-full" loading="lazy" />
            </span>
          </span>
        </div>
      </article>

      <!-- card C: community orbit -->
      <article class="card-shell solution-card">
        <div class="card-copy">
          <h3 class="font-pixel text-[40px] leading-[0.95] text-white light:text-[#1c1512]">Never learning alone</h3>
          <p class="text-[16px] leading-[1.5] text-[#dedddd] light:text-[#525252]">
            A community of 2.64M+ learners, plus fibu and Grandma in your corner.
          </p>
        </div>
        <CommunityOrbit />
      </article>
    </div>
  </div>
</section>

<style>
  .card-shell {
    position: relative;
    height: 460px;
    width: 100%;
    max-width: 392px;
    margin-inline: auto;
    overflow: clip;
    border-radius: 24px;
    border: 1px solid var(--card-border);
    box-shadow: var(--card-shadow);
    background-image: var(--card-grad);
  }

  .card-copy {
    position: absolute;
    left: 24px;
    top: 24px;
    width: calc(100% - 48px);
    display: flex;
    flex-direction: column;
    gap: 8px;
    z-index: 1;
  }

  /* Each card declares where it comes from; the shared .reveal rules below
     handle the timing so all three land together. */
  .reveal {
    --reveal-to: none;
  }

  /* Start just past the viewport edge: half the screen plus half the card's own
     width clears it at every breakpoint, single-column mobile included. */
  .reveal-from-left {
    --reveal-from: translateX(calc(-50vw - 50%));
  }

  .reveal-from-right {
    --reveal-from: translateX(calc(50vw + 50%));
  }

  /* Middle card holds its position and swings in edge-on instead. Stopping at a
     quarter turn keeps the front face forward the whole way — a half turn would
     show the card's mirrored back. */
  .reveal-flip {
    --reveal-from: perspective(1200px) rotateY(90deg);
    --reveal-to: perspective(1200px) rotateY(0deg);
  }

  /* Band that the middle outbound node dims through: the solution heading's own
     box, plus a little either side for the fade to ramp in. The heading starts
     176px below the icon at every breakpoint the connector is visible at; only
     its height changes with the font size, so only --dim-h needs a breakpoint.
     Connector.astro turns these into the mask rect's y/height. */
  .solution-wires {
    --dim-y: 162px;
    --dim-h: 92px; /* 14px ramp + 64px heading (lg) + 14px ramp */
  }

  @media (max-width: 1023px) {
    .solution-wires {
      --dim-h: 72px; /* heading is 44px below lg */
    }
  }

  /* Impact flash. The outbound node is absorbed into the card at the end of its
     travel; this lights the card's border for two quick pulses at that moment,
     then hands the border straight back to the theme's resting value. Not
     `forwards` — the resting style is the card's own, so nothing is left stuck
     on when the animation finishes. */
  @keyframes card-impact {
    0% {
      border-color: var(--card-border);
      box-shadow: var(--card-shadow);
    }
    8% {
      border-color: rgb(255 149 45 / 0.95);
      box-shadow: 0 0 28px rgb(255 149 45 / var(--impact-glow));
    }
    28% {
      border-color: rgb(255 149 45 / 0.18);
      box-shadow: 0 0 10px rgb(255 149 45 / calc(var(--impact-glow) * 0.25));
    }
    48% {
      border-color: rgb(255 149 45 / 0.8);
      box-shadow: 0 0 22px rgb(255 149 45 / calc(var(--impact-glow) * 0.78));
    }
    100% {
      border-color: var(--card-border);
      box-shadow: var(--card-shadow);
    }
  }

  .solution-card {
    /* The glow has to work over both a black and a white card, so its strength
       is a token rather than a fixed alpha. */
    --impact-glow: 0.38;
  }

  :global(html.light) .solution-card {
    --impact-glow: 0.55;
  }

  /* Both flame animations pivot on the wick rather than the centre, so the base
     stays planted and only the body moves. */
  .streak-flame,
  .streak-day {
    transform-origin: 50% 100%;
  }

  /* Gap between one day catching and the next. */
  .streak-day {
    --step: 260ms;
  }

  /* A slow breath with quicker flickers layered over it. The two loops are
     deliberately coprime lengths, so the flame and the glow behind it drift in
     and out of phase instead of pulsing in lockstep. */
  @keyframes flame-flicker {
    0%,
    100% {
      transform: scale(1, 1);
      opacity: 1;
    }
    18% {
      transform: scale(0.985, 1.035);
      opacity: 0.94;
    }
    34% {
      transform: scale(1.02, 0.975);
      opacity: 1;
    }
    52% {
      transform: scale(0.99, 1.045);
      opacity: 0.9;
    }
    68% {
      transform: scale(1.015, 0.99);
      opacity: 0.98;
    }
    84% {
      transform: scale(0.995, 1.02);
      opacity: 0.95;
    }
  }

  /* Square wave rather than a fade — a code caret snaps on and off. Its rhythm
     is independent of the typing, so it keeps blinking through the pause. */
  @keyframes caret-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  @keyframes flame-glow {
    0%,
    100% {
      opacity: 0.88;
    }
    40% {
      opacity: 1;
    }
    70% {
      opacity: 0.82;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .solution-card.is-hit {
      animation: card-impact 900ms ease-out;
    }

    /* Hit reaction: the card lifts the way a hovered card would.

       These cards have no :hover rule to reuse — there is none anywhere in this
       component — so the look is defined here for the first time, in the site's
       existing card idiom (BlogCard's lift-on-hover). A real
       `.solution-card:hover` can share it later by joining the selector below;
       nothing else would have to change.

       Deliberately only `transform`. The border highlight and glow that complete
       the hover look already arrive at this same instant from `card-impact`
       above, and a running CSS animation outranks plain declarations — so
       setting border-color/box-shadow here would be overridden for the entire
       time this class is on the card, i.e. dead style. The two classes split the
       job instead: card-impact owns the border and glow, this owns the lift. */
    .solution-card.hover-active {
      transform: translateY(-6px) scale(1.006);
    }

    /* On the way in and back out, so it reads as a hover settling rather than a
       jump. Shorter than the hold, so the card is fully lifted for a moment. */
    .solution-card {
      transition: transform 260ms ease-out;
    }

    .code-caret {
      animation: caret-blink 1.06s step-end infinite;
    }

    .streak-flame {
      animation: flame-flicker 3.2s ease-in-out infinite;
    }

    .streak-glow {
      animation: flame-glow 4.1s ease-in-out infinite;
    }

    /* Each day starts snuffed out and small. The delay ladder is pure CSS —
       the script only has to say "go" once. */
    :global(html.js-motion) .streak-day {
      opacity: 0;
      transform: scale(0.4) translateY(6px);
    }

    :global(html.js-motion) .streak-day.is-lit {
      opacity: 1;
      transform: scale(1) translateY(0);
      /* Overshoot on the way in, so each day lands with a small flare rather
         than merely fading up. */
      transition:
        transform 520ms cubic-bezier(0.34, 1.56, 0.64, 1),
        opacity 300ms ease-out;
      transition-delay: calc(var(--day) * var(--step));
    }

    :global(html.js-motion) .reveal {
      opacity: 0;
      transform: var(--reveal-from);
    }

    /* Transition lives on the end state so the cards ease in once and never
       animate back out. A long, gently-decelerating glide rather than a snap —
       the whole travel from the screen edge should be readable. */
    :global(html.js-motion) .reveal.is-revealed {
      opacity: 1;
      transform: var(--reveal-to);
      transition:
        transform 2.2s cubic-bezier(0.33, 0.02, 0.24, 1),
        opacity 1.2s ease-out;
    }
  }
</style>

<script>
  const grid = document.getElementById('problem-cards');
  const cards = grid ? Array.from(grid.querySelectorAll<HTMLElement>('.reveal')) : [];

  if (grid && cards.length) {
    const reveal = () => cards.forEach((card) => card.classList.add('is-revealed'));

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      reveal();
    } else {
      // Starts just before the row scrolls into view so the slow glide has room
      // to land, then stops watching — the cards stay put on the way back up.
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            observer.disconnect();
            reveal();
          });
        },
        { rootMargin: '0px 0px 10% 0px' }
      );

      observer.observe(grid);
    }
  }

  // Editor's active line types itself out, holds, clears, and starts over. The
  // text lives in data-code so the line still ships empty, exactly as designed,
  // and nothing flashes before the script runs.
  const codeLine = document.getElementById('code-line');
  const code = codeLine?.dataset.code ?? '';

  if (codeLine && code) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      // No typing, but still show what would have been typed.
      codeLine.textContent = code;
    } else {
      const PER_CHAR = 70;
      const HOLD = 1800; // finished line stays up long enough to read
      const BLANK = 500; // beat on the empty line before the next pass

      let typed = 0;
      const tick = () => {
        codeLine.textContent = code.slice(0, typed);

        if (typed < code.length) {
          typed += 1;
          setTimeout(tick, PER_CHAR);
          return;
        }

        setTimeout(() => {
          typed = 0;
          codeLine.textContent = '';
          setTimeout(tick, BLANK);
        }, HOLD);
      };

      tick();
    }
  }

  // Impact flash: each solution card's border lights up on the frame the
  // outbound node lands on it.
  //
  // The timing is read from the wires' own SMIL clock rather than kept on a
  // separate JS timer. `getCurrentTime()` is the same timeline animateMotion
  // runs on, so re-reading it before every flash means the two can never drift
  // apart — a plain setInterval would slowly slide off the arrival.
  const solutionSection = document.getElementById('solution');
  // Specifically a connector's own <svg> — the cards further down hold unrelated
  // inline SVG, so a bare 'svg' lookup here is not necessarily a wire.
  const outboundWire = document.querySelector<SVGPathElement>('#wire-out-middle')?.ownerSVGElement;
  const solutionCards = solutionSection
    ? Array.from(solutionSection.querySelectorAll<HTMLElement>('.solution-card'))
    : [];

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Must match Connector.astro's CYCLE, and the point in it where the outbound
  // node finishes its travel (its opacity fade-out starts at 0.97).
  const WIRE_CYCLE = 6.4;
  const IMPACT_AT = 0.97;

  if (
    solutionSection &&
    outboundWire &&
    solutionCards.length &&
    !reducedMotion &&
    typeof outboundWire.getCurrentTime === 'function'
  ) {
    let timer = 0;
    let running = false;

    // How long the card holds the lifted, hovered-looking state. Long enough to
    // register as a hover rather than a twitch, short enough to be back at rest
    // well before the next node arrives.
    const HOVER_HOLD = 500;
    const hoverTimers = new WeakMap<HTMLElement, number>();

    const clearHit = (card: HTMLElement) => card.classList.remove('is-hit');

    const clearHover = (card: HTMLElement) => {
      const pending = hoverTimers.get(card);
      if (pending) {
        window.clearTimeout(pending);
        hoverTimers.delete(card);
      }
      card.classList.remove('hover-active');
    };

    for (const card of solutionCards) card.addEventListener('animationend', () => clearHit(card));

    const flash = () => {
      for (const card of solutionCards) {
        card.classList.remove('is-hit');
        // Reading layout between remove and add restarts the animation when a
        // flash is still mid-run from the previous cycle.
        void card.offsetWidth;
        card.classList.add('is-hit');

        // The hovered look rides the same arrival, on its own shorter clock —
        // the border flash and the lift are separate effects with separate
        // lifetimes, so they get separate timers rather than sharing one.
        // Each card carries its own, keyed to the card, so one card's reset can
        // never cancel another's.
        clearHover(card);
        card.classList.add('hover-active');
        hoverTimers.set(
          card,
          window.setTimeout(() => {
            card.classList.remove('hover-active');
            hoverTimers.delete(card);
          }, HOVER_HOLD),
        );
      }
      queue();
    };

    const queue = () => {
      const elapsed = outboundWire.getCurrentTime() % WIRE_CYCLE;
      let wait = IMPACT_AT * WIRE_CYCLE - elapsed;
      // Already past this cycle's arrival — take the next one.
      if (wait <= 0.05) wait += WIRE_CYCLE;
      timer = window.setTimeout(flash, wait * 1000);
    };

    // Nothing to flash while the section is off-screen, and no reason to hold a
    // timer open either.
    const impactObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && !running) {
            running = true;
            queue();
          } else if (!entry.isIntersecting && running) {
            running = false;
            window.clearTimeout(timer);
            solutionCards.forEach(clearHit);
            solutionCards.forEach(clearHover);
          }
        }
      },
      { rootMargin: '10% 0px' },
    );

    impactObserver.observe(solutionSection);
  }

  // Streak days catch one after another, once, the first time the card is
  // properly on screen — the stagger itself is the CSS delay ladder.
  const streakCard = document.getElementById('streak-card');
  const days = streakCard ? Array.from(streakCard.querySelectorAll<HTMLElement>('.streak-day')) : [];

  if (streakCard && days.length) {
    const light = () => days.forEach((day) => day.classList.add('is-lit'));

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      light();
    } else {
      // Waits for a good part of the card rather than its first pixel, so the
      // row isn't already finished by the time it's worth looking at.
      const streakObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            streakObserver.disconnect();
            light();
          });
        },
        { threshold: 0.45 }
      );

      streakObserver.observe(streakCard);
    }
  }
</script>
