---
const navLinks = [
  { label: 'How it works', href: '#how-it-works' },
  { label: 'Courses', href: '#courses' },
  { label: 'Premium', href: '#premium' },
  { label: 'Blog', href: '#blog' },
];
---

<header class="relative z-30 flex justify-center px-4 pt-[29px]">
  <nav
    class="flex w-full max-w-[800px] items-center justify-between gap-3 rounded-[28px] border border-[rgba(255,242,240,0.1)] bg-[#030003] py-[14px] pl-4 pr-4 shadow-[0_10px_40px_rgba(0,0,0,0.5)] light:border-[rgba(0,0,0,0.07)] light:bg-white light:shadow-[0_8px_30px_rgba(28,21,18,0.08)] sm:gap-6 sm:pl-5 sm:pr-5 lg:gap-10"
  >
    <div class="flex items-center gap-12">
      <a href="/" class="relative block h-12 w-24 shrink-0 overflow-clip" aria-label="Fibu — home">
        <span class="absolute" style="inset: -7.6% 55.07% 8.86% -4.44%;">
          <img src="/images/logo-fox-outline.svg" alt="" class="block size-full" />
        </span>
        <span
          class="absolute"
          style="inset: 3.69% 63.14% -11.79% 3.66%; mask-image: url('/images/logo-fox-mask.svg'); -webkit-mask-image: url('/images/logo-fox-mask.svg'); mask-mode: alpha; mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: -10.199px -9.975px; -webkit-mask-position: -10.199px -9.975px; mask-size: 51.973px 51.949px; -webkit-mask-size: 51.973px 51.949px;"
        >
          <img src="/images/logo-fox-fill.svg" alt="" class="block size-full" />
        </span>
        <span class="absolute" style="inset: 38.55% 0 16.11% 41.02%;">
          <img src="/images/logo-wordmark.svg" alt="" class="block size-full transition-[filter] duration-300 light:brightness-0" />
        </span>
      </a>

      <ul class="hidden items-center gap-10 whitespace-nowrap md:flex">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="whitespace-nowrap text-[16px] leading-[1.7] text-white transition-colors hover:text-[#ff952d] light:text-[#1c1512]"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="flex items-center gap-3">
      <!-- Theme toggle (not in Figma; styled to match the pill/border/accent language) -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark and light mode"
        class="relative flex size-12 shrink-0 items-center justify-center overflow-hidden rounded-[16px] border border-[rgba(255,242,240,0.12)] bg-[#0a0604] text-[#ff952d] transition-colors hover:border-[rgba(255,149,45,0.5)] light:border-[rgba(0,0,0,0.08)] light:bg-[#f4f1ec] light:hover:border-[rgba(255,149,45,0.6)]"
      >
        <!-- moon: shown in dark mode -->
        <svg
          class="size-5 transition-all duration-300 ease-out light:scale-0 light:-rotate-90 light:opacity-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
        <!-- sun: shown in light mode -->
        <svg
          class="absolute size-5 scale-0 rotate-90 opacity-0 transition-all duration-300 ease-out light:scale-100 light:rotate-0 light:opacity-100"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
      </button>

      <a href="#start" class="block w-[124px] shrink-0 rounded-[16px] bg-[#e77a00] pb-[4px]">
        <span
          class="font-satoshi flex h-12 w-full items-center justify-center whitespace-nowrap rounded-[16px] bg-[#ff952d] text-center text-[16px] font-bold leading-[22px] text-[#0a0a0a] transition-transform duration-100 active:translate-y-[2px]"
        >
          Start Free
        </span>
      </a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const html = document.documentElement;
    const toLight = !html.classList.contains('light');
    html.classList.add('theme-anim');
    html.classList.toggle('light', toLight);
    html.classList.toggle('dark', !toLight);
    try {
      localStorage.setItem('theme', toLight ? 'light' : 'dark');
    } catch (e) {}
    window.setTimeout(() => html.classList.remove('theme-anim'), 400);
  });
</script>
