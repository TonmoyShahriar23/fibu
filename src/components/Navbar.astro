---
const navLinks = [
  { label: 'How it works', href: '#how-it-works' },
  { label: 'Courses', href: '#courses' },
  { label: 'Premium', href: '#premium' },
  { label: 'Blog', href: '#blog' },
];
---

<header class="relative z-30 flex justify-center px-4 pt-[29px]">
  <nav
    class="flex w-full max-w-[718px] items-center justify-between gap-10 rounded-[24px] border border-[rgba(255,242,240,0.1)] bg-[#030003] py-3 pl-4 pr-3"
  >
    <div class="flex items-center gap-12">
      <a href="/" class="relative block h-12 w-24 shrink-0 overflow-clip" aria-label="Fibu — home">
        <span class="absolute" style="inset: -7.6% 55.07% 8.86% -4.44%;">
          <img src="/images/logo-fox-outline.svg" alt="" class="block size-full" />
        </span>
        <span
          class="absolute"
          style="inset: 3.69% 63.14% -11.79% 3.66%; mask-image: url('/images/logo-fox-mask.svg'); -webkit-mask-image: url('/images/logo-fox-mask.svg'); mask-mode: alpha; mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: -10.199px -9.975px; -webkit-mask-position: -10.199px -9.975px; mask-size: 51.973px 51.949px; -webkit-mask-size: 51.973px 51.949px;"
        >
          <img src="/images/logo-fox-fill.svg" alt="" class="block size-full" />
        </span>
        <span class="absolute" style="inset: 38.55% 0 16.11% 41.02%;">
          <img src="/images/logo-wordmark.svg" alt="" class="block size-full" />
        </span>
      </a>

      <ul class="hidden items-center gap-10 whitespace-nowrap md:flex">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="whitespace-nowrap text-[16px] leading-[1.7] text-white transition-colors hover:text-[#ff952d]"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <a href="#start" class="block w-[124px] shrink-0 rounded-[16px] bg-[#e77a00] pb-[4px]">
      <span
        class="font-satoshi flex h-12 w-full items-center justify-center whitespace-nowrap rounded-[16px] bg-[#ff952d] text-center text-[16px] font-bold leading-[22px] text-[#0a0a0a] transition-transform duration-100 active:translate-y-[2px]"
      >
        Start Free
      </span>
    </a>
  </nav>
</header>
