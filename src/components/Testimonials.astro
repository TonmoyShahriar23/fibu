// The three former grid columns become three marquee rows, alternating direction
// so the middle row counter-scrolls against the other two. Each row is rendered
// twice back-to-back so translating the track by exactly -50%→0 loops seamlessly;
// slightly different durations keep the rows from marching in lockstep.
const rows = [
  { items: testimonials.slice(0, 3), duration: '46s', reverse: false },
  { items: testimonials.slice(3, 6), duration: '58s', reverse: true },
  { items: testimonials.slice(6, 9), duration: '52s', reverse: false },
];
---

<section
  id="testimonials"
  aria-labelledby="testimonials-heading"
  class="relative z-10 mx-auto mt-[120px] flex w-full max-w-[1224px] flex-col items-center gap-12 px-4"
>
  <div class="flex w-full flex-col items-center gap-4 text-center">
    <h2
      id="testimonials-heading"
      class="heading-gradient font-pixel max-w-[600px] text-[40px] uppercase leading-[0.9] sm:text-[52px] xl:text-[64px]"
    >
      2.64M+ people started exactly where you are
    </h2>
    <p class="max-w-[536px] text-[16px] leading-[1.6] text-[#7e7e7e] light:text-[#525252]">
      Some are now developers. Some are building startups. All of them started with day one.
    </p>
  </div>

  <div class="fade-grid flex w-full flex-col gap-6">
    {rows.map((row) => (
      <div class="marquee-row w-full overflow-hidden">
        <div
          class:list={[
            'marquee-track flex w-full flex-col gap-6 md:w-max md:flex-row md:gap-0',
            row.reverse && 'is-reverse',
          ]}
          style={`--marquee-duration: ${row.duration};`}
        >
          {[...row.items, ...row.items].map((t, i) => (
            <article
              class:list={[
                'w-full shrink-0 flex-col gap-5 rounded-[24px] border border-[#2c2a2a] bg-[#070606] p-6 light:border-[#e8e1d7] light:bg-white light:shadow-[0_6px_24px_rgba(28,21,18,0.05)] md:mr-6 md:w-[320px] lg:w-[392px]',
                // the loop copies only exist to feed the marquee, so on phones —
                // where nothing scrolls — they'd just be duplicate cards
                i >= row.items.length ? 'hidden md:flex' : 'flex',
              ]}
              aria-hidden={i >= row.items.length ? 'true' : 'false'}
            >
              <div class="flex items-center gap-4">
                <img
                  src={t.avatar}
                  alt={`Portrait of ${t.name}`}
                  class="size-12 shrink-0 rounded-[8px] object-cover"
                  width="48"
                  height="48"
                  loading="lazy"
                />
                <div class="flex flex-col justify-center gap-2">
                  <p class="text-[20px] font-semibold leading-[1.1] tracking-[-0.5px] text-white light:text-[#1c1512]">
                    {t.name}
                  </p>
                  <p class="text-[14px] leading-[1.5] text-[#9e9e9e] light:text-[#737373]">{t.role}</p>
                </div>
              </div>
              <div class="w-full border-t border-[#2c2a2a] light:border-[#e8e1d7]"></div>
              <p class="font-geist text-[16px] leading-[1.7] tracking-[-0.3px] text-[#bebdbd] light:text-[#525252]">
                {t.quote}
              </p>
            </article>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  /* The peek-fade is calibrated for the full-width xl layout. On narrower screens
     the cards shrink and quotes wrap to more lines, so the rows get tall enough
     that a fade starting at 51.7% would swallow most of the last two rows. */
  @media (min-width: 1280px) {
    .fade-grid {
      -webkit-mask-image: linear-gradient(to bottom, #000 51.7%, transparent 100%);
      mask-image: linear-gradient(to bottom, #000 51.7%, transparent 100%);
    }
  }

  /* The whole marquee is a tablet-and-up treatment. Phones keep the cards as a
     plain stacked list: sideways motion on a narrow screen only ever shows one
     card at a time, and it fights with vertical page scrolling. Below 768px the
     track is a normal flex column (see the md: utilities in the markup), so
     everything here stays scoped to the horizontal layout. */
  @media (min-width: 768px) {
    /* Soften the two ends so cards enter and leave instead of being cut off. */
    .marquee-row {
      -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
      mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    }

    /* Rows 1 and 3 travel left → right forever. The track holds two identical
       copies of the row, so sliding it from -50% to 0 advances by exactly one
       copy and restarts invisibly. Cards are spaced with margin-right rather
       than a flex gap — a gap would sit between the two copies as well and throw
       the 50% off by half a gap, which shows up as a jump every loop. */
    .marquee-track {
      animation: marquee-right var(--marquee-duration, 50s) linear infinite;
      will-change: transform;
    }

    /* Row 2 runs the same keyframes backwards: 0 → -50%, i.e. right → left. The
       loop stays seamless because both ends of the travel are equivalent frames. */
    .marquee-track.is-reverse {
      animation-direction: reverse;
    }

    /* Give people a way to stop and actually read a card. */
    .marquee-row:hover .marquee-track {
      animation-play-state: paused;
    }
  }

  @keyframes marquee-right {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      transform: none;
    }
  }
</style>
