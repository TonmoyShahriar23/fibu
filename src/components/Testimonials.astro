<section class="relative z-10 mx-auto mt-[120px] flex w-full max-w-[1224px] flex-col items-center gap-12 px-4">
  <div class="flex w-full flex-col items-center gap-4 text-center">
    <h2
      class="heading-gradient font-pixel max-w-[600px] text-[40px] uppercase leading-[0.9] sm:text-[52px] xl:text-[64px]"
    >
      2.64M+ people started exactly where you are
    </h2>
    <p class="max-w-[536px] text-[16px] leading-[1.6] text-[#7e7e7e]">
      Some are now developers. Some are building startups. All of them started with day one.
    </p>
  </div>

  <div class="fade-grid grid w-full grid-cols-1 items-start gap-6 md:grid-cols-2 xl:grid-cols-3">
    {testimonials.map((t) => (
      <article
        class="flex flex-col gap-5 rounded-[24px] border border-[#2c2a2a] bg-[#070606] p-6"
      >
        <div class="flex items-center gap-4">
          <img
            src={t.avatar}
            alt={`Portrait of ${t.name}`}
            class="size-12 shrink-0 rounded-[8px] object-cover"
            width="48"
            height="48"
            loading="lazy"
          />
          <div class="flex flex-col justify-center gap-2">
            <p class="text-[20px] font-semibold leading-[1.1] tracking-[-0.5px] text-white">
              {t.name}
            </p>
            <p class="text-[14px] leading-[1.5] text-[#9e9e9e]">{t.role}</p>
          </div>
        </div>
        <div class="w-full border-t border-[#2c2a2a]"></div>
        <p class="font-geist text-[16px] leading-[1.7] tracking-[-0.3px] text-[#bebdbd]">
          {t.quote}
        </p>
      </article>
    ))}
  </div>
</section>

<style>
  .heading-gradient {
    background-image: linear-gradient(to bottom, #ffffff 0%, #0c0c0c 182%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .fade-grid {
    -webkit-mask-image: linear-gradient(to bottom, #000 51.7%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 51.7%, transparent 100%);
  }
</style>
