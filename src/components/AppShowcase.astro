---
const tabs = [
  { icon: '📕', label: 'Learn', active: true },
  { icon: '💻', label: 'Practice', active: false },
  { icon: '🏆', label: 'Leaderboard', active: false },
  { icon: '🚩', label: 'Forum', active: false },
  { icon: '👤', label: 'Profile', active: false },
];
---

<section class="showcase relative overflow-hidden bg-[#050308] py-24 text-white sm:py-32">
  <!-- star field -->
  <div class="stars stars-sm pointer-events-none absolute inset-0"></div>
  <div class="stars stars-lg pointer-events-none absolute inset-0"></div>
  <!-- soft glow behind the phone -->
  <div class="phone-glow pointer-events-none absolute inset-0"></div>

  <div class="relative z-10 mx-auto flex max-w-6xl justify-center px-4">
    <!-- phone frame -->
    <div class="w-[340px] rounded-[3.2rem] bg-gradient-to-b from-[#e8ddc8] via-[#9c927e] to-[#e8ddc8] p-[3px] shadow-[0_30px_80px_rgba(0,0,0,0.8)] sm:w-[380px]">
      <div class="rounded-[3rem] bg-black p-[6px]">
        <div class="relative overflow-hidden rounded-[2.6rem] bg-[#050505]">
          <!-- in-screen star dust -->
          <div class="stars stars-sm pointer-events-none absolute inset-0 opacity-60"></div>

          <!-- status bar + dynamic island -->
          <div class="relative flex items-center justify-between px-8 pb-2 pt-4">
            <span class="text-sm font-semibold tracking-wide">9:41</span>
            <div class="absolute left-1/2 top-3 h-7 w-24 -translate-x-1/2 rounded-full bg-[#151515]"></div>
            <div class="flex items-center gap-1.5">
              <!-- signal -->
              <svg viewBox="0 0 18 12" class="h-3 w-4 fill-white" aria-hidden="true">
                <rect x="0" y="8" width="3" height="4" rx="0.8" />
                <rect x="5" y="5.5" width="3" height="6.5" rx="0.8" />
                <rect x="10" y="3" width="3" height="9" rx="0.8" />
                <rect x="15" y="0" width="3" height="12" rx="0.8" />
              </svg>
              <!-- wifi -->
              <svg viewBox="0 0 16 12" class="h-3 w-4 fill-white" aria-hidden="true">
                <path d="M8 9.5a1.7 1.7 0 1 1 0 3.4 1.7 1.7 0 0 1 0-3.4zM8 5.4c1.7 0 3.2.6 4.4 1.7l-1.5 1.6A4.4 4.4 0 0 0 8 7.6c-1.1 0-2.1.4-2.9 1.1L3.6 7.1A6.5 6.5 0 0 1 8 5.4zM8 1.2c2.8 0 5.4 1.1 7.3 2.9l-1.5 1.5A8.4 8.4 0 0 0 8 3.4c-2.2 0-4.3.9-5.8 2.3L.7 4.1A10.5 10.5 0 0 1 8 1.2z" />
              </svg>
              <!-- battery -->
              <svg viewBox="0 0 25 12" class="h-3 w-6" aria-hidden="true">
                <rect x="0.5" y="0.5" width="21" height="11" rx="3" fill="none" stroke="white" stroke-opacity="0.5" />
                <rect x="2" y="2" width="18" height="8" rx="1.8" fill="white" />
                <path d="M23 4v4c1.1-.3 1.8-1 1.8-2S24.1 4.3 23 4z" fill="white" fill-opacity="0.5" />
              </svg>
            </div>
          </div>

          <!-- currency row -->
          <div class="relative flex items-center justify-between px-6 pt-1">
            <button class="flex items-center gap-1.5" aria-label="Course: JavaScript">
              <span class="flex h-7 w-7 items-center justify-center rounded-md border-2 border-[#3fb950] bg-[#0d2013] text-[9px] font-bold text-[#3fb950]" style="clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%);">JS</span>
              <svg viewBox="0 0 10 6" class="h-2 w-3 fill-white/80" aria-hidden="true">
                <path d="M0 0h10L5 6z" />
              </svg>
            </button>
            <div class="flex items-center gap-5">
              <span class="flex items-center gap-1.5 text-sm font-semibold">
                <span class="text-base" aria-hidden="true">💎</span> 728
              </span>
              <span class="flex items-center gap-1.5 text-sm font-semibold">
                <span class="text-base" aria-hidden="true">💗</span> 240
              </span>
            </div>
          </div>

          <!-- module card -->
          <div class="relative mx-4 mt-4 flex items-center justify-between gap-3 rounded-2xl bg-[#a855f7] px-4 py-3 shadow-[0_8px_24px_rgba(168,85,247,0.35)]">
            <div>
              <div class="flex items-center gap-2">
                <span class="text-[10px] font-semibold uppercase tracking-widest text-white/70">Module 1</span>
                <span class="rounded-full bg-[#f9a03c] px-2 py-0.5 text-[9px] font-bold uppercase tracking-wide text-[#3b1c04]">Pro</span>
              </div>
              <p class="mt-0.5 text-[15px] font-semibold text-white">Relative Units and Fluid Layouts</p>
            </div>
            <button class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white/15" aria-label="Module menu">
              <svg viewBox="0 0 16 12" class="h-4 w-4 fill-white" aria-hidden="true">
                <rect x="0" y="0" width="16" height="2" rx="1" />
                <rect x="0" y="5" width="16" height="2" rx="1" />
                <rect x="0" y="10" width="16" height="2" rx="1" />
              </svg>
            </button>
          </div>

          <!-- lesson path -->
          <div class="relative px-4 pb-24 pt-5">
            <!-- Lesson 1 — planet left -->
            <div class="relative rounded-[2.5rem] border border-dashed border-white/20 p-3">
              <div class="flex items-center gap-4">
                <div class="planet planet-lesson1 shrink-0"></div>
                <div class="min-w-0 flex-1">
                  <p class="text-[10px] font-semibold uppercase tracking-widest text-white/50">Lesson 1</p>
                  <p class="mt-0.5 text-sm font-medium text-white">Showing a message</p>
                  <div class="mt-2 h-1 w-full overflow-hidden rounded-full bg-white/15">
                    <div class="h-full w-[20%] rounded-full bg-[#4ade80]"></div>
                  </div>
                  <div class="mt-1.5 flex items-center justify-between text-[11px] text-white/60">
                    <span>In Progress</span>
                    <span>20%</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Lesson 2 — planet right -->
            <div class="relative mt-5 rounded-[2.5rem] border border-dashed border-white/20 p-3">
              <div class="flex flex-row-reverse items-center gap-4">
                <div class="relative shrink-0">
                  <div class="planet planet-lesson2"></div>
                  <span class="crown absolute -top-2 left-1/2 -translate-x-1/2" aria-hidden="true">👑</span>
                </div>
                <div class="min-w-0 flex-1">
                  <p class="text-[10px] font-semibold uppercase tracking-widest text-white/50">Lesson 2</p>
                  <p class="mt-0.5 text-sm font-medium text-white">Showing numbers</p>
                  <div class="mt-2 h-1 w-full overflow-hidden rounded-full bg-white/15">
                    <div class="h-full w-full rounded-full bg-[#4ade80]"></div>
                  </div>
                  <div class="mt-1.5 flex items-center justify-between text-[11px] text-white/60">
                    <span>Completed</span>
                    <span>100%</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Lesson 3 — planet left -->
            <div class="relative mt-5 rounded-[2.5rem] border border-dashed border-white/20 p-3">
              <div class="flex items-center gap-4">
                <div class="relative shrink-0">
                  <div class="planet planet-lesson3"></div>
                  <span class="crown absolute -top-2 left-1/2 -translate-x-1/2" aria-hidden="true">👑</span>
                </div>
                <div class="min-w-0 flex-1">
                  <p class="text-[10px] font-semibold uppercase tracking-widest text-white/50">Lesson 3</p>
                  <p class="mt-0.5 text-sm font-medium text-white">Multiple outputs</p>
                  <div class="mt-2 h-1 w-full overflow-hidden rounded-full bg-white/15">
                    <div class="h-full w-[55%] rounded-full bg-[#4ade80]"></div>
                  </div>
                  <div class="mt-1.5 flex items-center justify-between text-[11px] text-white/60">
                    <span>In Progress</span>
                    <span>55%</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Lesson 4 — partially hidden behind the promo toast -->
            <div class="relative mt-5 px-3">
              <p class="text-center text-[10px] font-semibold uppercase tracking-widest text-white/50">Lesson 4</p>
              <div class="planet planet-lesson4 mx-auto mt-2"></div>
            </div>

            <!-- promo toast -->
            <div class="absolute bottom-16 left-4 right-4 flex items-center gap-3 rounded-2xl border border-[#f9a03c] bg-[#171004]/95 px-3 py-2.5 shadow-[0_10px_30px_rgba(0,0,0,0.6)]">
              <span class="text-3xl leading-none" aria-hidden="true">🦊</span>
              <div class="min-w-0 flex-1">
                <p class="text-[11px] text-white/70">Welcome aboard, Cadet!</p>
                <p class="text-sm font-semibold text-white">Claim Your <span class="text-[#f9a03c]">30% OFF</span></p>
              </div>
              <button class="p-1 text-white/60 transition-colors hover:text-white" aria-label="Dismiss offer">
                <svg viewBox="0 0 12 12" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
                  <path d="M1 1l10 10M11 1L1 11" />
                </svg>
              </button>
            </div>
          </div>

          <!-- bottom tab bar -->
          <div class="absolute bottom-0 left-0 right-0 rounded-b-[2.6rem] bg-[#141414]/95 px-3 pb-3 pt-2 backdrop-blur">
            <div class="flex items-start justify-between">
              {tabs.map((tab) => (
                <button class="flex w-14 flex-col items-center gap-1" aria-label={tab.label}>
                  <span class="text-base leading-none" aria-hidden="true">{tab.icon}</span>
                  <span class={`text-[9px] ${tab.active ? 'font-semibold text-white' : 'text-white/50'}`}>
                    {tab.label}
                  </span>
                </button>
              ))}
            </div>
            <div class="mx-auto mt-2 h-1 w-28 rounded-full bg-white/80"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .phone-glow {
    background: radial-gradient(ellipse 40% 50% at 50% 50%, rgba(80, 60, 140, 0.18), transparent 70%);
  }

  .stars {
    background-repeat: repeat;
  }

  .stars-sm {
    background-image:
      radial-gradient(1px 1px at 25px 35px, rgba(255, 255, 255, 0.6), transparent 100%),
      radial-gradient(1px 1px at 120px 90px, rgba(255, 255, 255, 0.4), transparent 100%),
      radial-gradient(1px 1px at 210px 160px, rgba(255, 255, 255, 0.5), transparent 100%),
      radial-gradient(1px 1px at 300px 60px, rgba(255, 255, 255, 0.35), transparent 100%),
      radial-gradient(1px 1px at 80px 220px, rgba(255, 255, 255, 0.4), transparent 100%),
      radial-gradient(1px 1px at 260px 260px, rgba(255, 255, 255, 0.4), transparent 100%);
    background-size: 340px 300px;
  }

  .stars-lg {
    background-image:
      radial-gradient(1.5px 1.5px at 60px 120px, rgba(255, 255, 255, 0.8), transparent 100%),
      radial-gradient(2px 2px at 320px 40px, rgba(180, 190, 255, 0.7), transparent 100%),
      radial-gradient(1.5px 1.5px at 460px 260px, rgba(255, 255, 255, 0.75), transparent 100%),
      radial-gradient(2px 2px at 180px 340px, rgba(255, 255, 255, 0.6), transparent 100%);
    background-size: 560px 420px;
  }

  .planet {
    border-radius: 9999px;
  }

  .planet-lesson1 {
    width: 76px;
    height: 76px;
    background: radial-gradient(circle at 35% 30%, #ffc46b 0%, #fb923c 35%, #ea580c 70%, #9a3412 100%);
    box-shadow: inset -12px -12px 20px rgba(60, 10, 0, 0.55), 0 0 26px rgba(234, 88, 12, 0.4);
  }

  .planet-lesson2 {
    width: 76px;
    height: 76px;
    background: radial-gradient(circle at 35% 30%, #ffffff 0%, #dbeafe 35%, #93c5fd 70%, #60a5fa 100%);
    box-shadow: inset -12px -12px 20px rgba(30, 60, 120, 0.35), 0 0 24px rgba(147, 197, 253, 0.3);
  }

  .planet-lesson3 {
    width: 76px;
    height: 76px;
    background: radial-gradient(circle at 35% 30%, #7dd3fc 0%, #38bdf8 35%, #2563eb 70%, #1e3a8a 100%);
    box-shadow: inset -12px -12px 20px rgba(10, 20, 80, 0.5), 0 0 24px rgba(56, 189, 248, 0.35);
  }

  .planet-lesson4 {
    width: 64px;
    height: 64px;
    background: radial-gradient(circle at 35% 30%, #8fe06a 0%, #58c76f 30%, #2f9df0 60%, #14507e 100%);
    box-shadow: inset -10px -10px 18px rgba(0, 0, 30, 0.5);
  }

  .crown {
    display: flex;
    height: 24px;
    width: 24px;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: #f9a03c;
    border: 2px solid #171004;
    font-size: 11px;
    line-height: 1;
  }
</style>
