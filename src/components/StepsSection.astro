---
// Figma node 14196:27317 (dark "1") / 14210:13595 (light "1"). Left: an
// auto-rotating carousel of three phone screens (module select, quiz, profile)
// with dedicated dark- and light-mode designs. Each set's 600x636 panels share
// a pixel-identical bezel, so cross-fading only changes the screen. The theme
// class swaps which set (dark vs light images) is shown. Right: three steps.
const screens = [
  {
    dark: '/images/features-phone.png',
    light: '/images/phone-screen-module-light.png',
    alt: 'Fibu course screen listing NodeJs modules with progress rings',
  },
  {
    dark: '/images/phone-screen-quiz.png',
    light: '/images/phone-screen-quiz-light.png',
    alt: 'Fibu quiz screen — choose the correct answer to a JavaScript question',
  },
  {
    dark: '/images/phone-screen-profile.png',
    light: '/images/phone-screen-profile-light.png',
    alt: 'Fibu profile screen with quest points, hearts, streak and activity graph',
  },
];

const steps = [
  {
    icon: '/images/step-icon-path.svg',
    inset: '1.56% 3.19%',
    title: 'Pick your path',
    body: 'Python, JavaScript, Web Dev, and more. No CS degree, no experience required.',
  },
  {
    icon: '/images/step-icon-mission.svg',
    inset: '14.6% 0.01% 14.6% 0',
    title: "Do today's 10-minute mission",
    body: 'Earn XP, keep your streak alive, level up as you go.',
  },
  {
    icon: '/images/step-icon-ship.svg',
    inset: '5.21% 13.53% 5.21% 13.55%',
    title: 'Ship something real',
    body: 'Every path ends in an actual project you can show off — not just a certificate.',
  },
];
---

<section
  id="how-it-works"
  aria-labelledby="how-it-works-heading"
  class="relative z-10 mx-auto mt-[120px] w-full max-w-[1440px] rounded-[32px] bg-[#171616] px-4 py-12 light:border light:border-[#ececec] light:bg-[#f6f6f6] light:shadow-[0_8px_30px_rgba(0,0,0,0.04)] sm:px-8 lg:px-[108px] lg:py-[80px]"
>
  <div class="flex flex-col items-center gap-12 lg:flex-row lg:gap-[48px]">
    <!-- phone carousel: static bezel, only the inner screen cross-fades -->
    <div
      class="phone-carousel w-full max-w-[600px] shrink-0"
      role="group"
      aria-roledescription="carousel"
      aria-label="Fibu app screens"
    >
      <div class="relative w-full" style="aspect-ratio: 600 / 636;">
        {screens.map((screen, i) => (
          <div
            class:list={['phone-screen absolute inset-0', i === 0 && 'is-active']}
            aria-hidden={i === 0 ? 'false' : 'true'}
          >
            <img
              src={screen.dark}
              alt={screen.alt}
              class="absolute inset-0 h-full w-full object-contain light:hidden"
              width="600"
              height="636"
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              draggable="false"
            />
            <img
              src={screen.light}
              alt={screen.alt}
              class="absolute inset-0 hidden h-full w-full object-contain light:block"
              width="600"
              height="636"
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              draggable="false"
            />
          </div>
        ))}
      </div>

      <div class="mt-6 flex items-center justify-center gap-2.5" role="tablist" aria-label="Choose app screen">
        {screens.map((screen, i) => (
          <button
            type="button"
            class:list={['phone-dot', i === 0 && 'is-active']}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-label={`Show screen ${i + 1} of ${screens.length}`}
          />
        ))}
      </div>
    </div>

    <div class="flex w-full max-w-[576px] flex-col gap-[60px] xl:gap-[120px]">
      <div class="flex flex-col gap-4">
        <h2
          id="how-it-works-heading"
          class="heading-gradient font-pixel text-[36px] uppercase leading-[0.9] sm:text-[48px] xl:text-[64px]"
        >
          From zero to your first real project 3 steps
        </h2>
        <p class="text-[18px] leading-[1.6] text-[#7e7e7e] light:text-[#525252]">
          Expand your team beyond borders with employer's global human platform. Manage global
          payroll, compliance, and benefits.
        </p>
      </div>

      <div class="relative flex flex-col gap-12">
        <img
          src="/images/step-connector.svg"
          alt=""
          class="absolute left-[28px] top-[70px] h-16 w-px"
          aria-hidden="true"
        />
        <img
          src="/images/step-connector.svg"
          alt=""
          class="absolute left-[28px] top-[190px] h-16 w-px"
          aria-hidden="true"
        />

        {steps.map((step, i) => (
          <div class:list={['step-item flex items-center gap-6', i === 0 && 'is-active']}>
            <div class="step-icon-tile relative shrink-0 rounded-[16px] border border-[#2e1200] p-3 light:border-[rgba(255,149,45,0.35)]">
              <span class="relative block size-8">
                <span class="absolute" style={`inset: ${step.inset};`}>
                  <img src={step.icon} alt="" class="block size-full" loading="lazy" />
                </span>
              </span>
            </div>
            <div class="flex flex-col gap-2">
              <h3 class="text-[20px] font-medium leading-[1.25] tracking-[-0.2px] text-white light:text-[#1c1512]">
                {step.title}
              </h3>
              <p class="text-[16px] leading-[1.6] text-[#7e7e7e] light:text-[#525252]">{step.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .step-icon-tile {
    background-color: rgba(99, 54, 0, 0.3);
    box-shadow: inset 0 0 12px 4px rgba(255, 149, 45, 0.5);
  }

  :global(.light) .step-icon-tile {
    background-color: #fdf4ea;
    box-shadow: none;
  }

  /* Steps mirror the carousel: the step matching the visible phone screen stays
     lit while the other two recede. Dimming the whole row keeps this working in
     both themes without a second set of color overrides. */
  .step-item {
    opacity: 0.45;
    transition: opacity 0.5s ease;
  }

  .step-item.is-active {
    opacity: 1;
  }

  /* Carousel: stacked screens cross-fade. The outgoing screen (.is-prev) stays
     fully opaque beneath the incoming one (.is-active) as it fades in, so the
     shared phone bezel never drops below 100% opacity — no frame flicker. */
  .phone-screen {
    opacity: 0;
    z-index: 0;
    transition: opacity 0.7s ease;
    user-select: none;
  }

  .phone-screen.is-prev {
    opacity: 1;
    z-index: 1;
  }

  .phone-screen.is-active {
    opacity: 1;
    z-index: 2;
  }

  .phone-dot {
    height: 8px;
    width: 8px;
    border-radius: 9999px;
    background-color: rgba(255, 255, 255, 0.28);
    transition:
      width 0.4s ease,
      background-color 0.4s ease;
    cursor: pointer;
  }

  .phone-dot.is-active {
    width: 26px;
    background-color: #ff952d;
  }

  :global(.light) .phone-dot {
    background-color: rgba(28, 21, 18, 0.18);
  }

  :global(.light) .phone-dot.is-active {
    background-color: #ff952d;
  }

  @media (prefers-reduced-motion: reduce) {
    .phone-screen,
    .step-item {
      transition: none;
    }
  }
</style>

<script>
  const carousel = document.querySelector<HTMLElement>('.phone-carousel');
  if (carousel) {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.phone-screen'));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('.phone-dot'));
    // steps live in the sibling column, so they're scoped to the section
    const steps = Array.from(
      carousel.closest('section')?.querySelectorAll<HTMLElement>('.step-item') ?? []
    );
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const INTERVAL = 2000;
    let index = 0;
    let timer: number | undefined;
    let inView = false;

    const render = (next: number) => {
      if (next === index) return;
      slides.forEach((s) => s.classList.remove('is-prev'));
      // current slide stays opaque underneath while the next one fades in on top
      slides[index].classList.add('is-prev');
      slides[index].classList.remove('is-active');
      slides[index].setAttribute('aria-hidden', 'true');

      index = next;
      slides[index].classList.add('is-active');
      slides[index].setAttribute('aria-hidden', 'false');

      dots.forEach((d, i) => {
        d.classList.toggle('is-active', i === index);
        d.setAttribute('aria-selected', i === index ? 'true' : 'false');
      });

      steps.forEach((s, i) => s.classList.toggle('is-active', i === index));
    };

    const stop = () => {
      if (timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
    };
    const start = () => {
      if (reduce || !inView || timer !== undefined) return;
      timer = window.setInterval(() => render((index + 1) % slides.length), INTERVAL);
    };

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        render(i);
        stop();
        start();
      });
    });

    carousel.addEventListener('mouseenter', stop);
    carousel.addEventListener('mouseleave', start);

    // Only auto-advance while the carousel is on screen.
    const io = new IntersectionObserver(
      (entries) => {
        inView = entries[0].isIntersecting;
        inView ? start() : stop();
      },
      { threshold: 0.35 }
    );
    io.observe(carousel);
  }
</script>
