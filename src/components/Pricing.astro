---
// Figma node 14196:27219 (y6873, 1224x682): "Ready to go further?" gradient
// heading, then "Pricing Plans" — a #171616 pill (8px padding, 28px radius)
// holding two 392px plan cards: Monthly (bg #0a0400, 2px #2c2a2a border, white
// text, white 3D button) and Yearly (bg white, #0a0400 text, orange 3D button).
const plans = [
  {
    name: 'Monthly',
    price: '$9.99',
    included: [
      'Up to 5 active hires',
      'Hire from 1 supported country',
      'Standard contract generation',
      'Access to compliance updates',
    ],
    extras: ['Basic reporting dashboard', 'Onboarding guide & help center'],
    dark: true,
  },
  {
    name: 'Yearly',
    price: '$48',
    included: [
      'Unlimited hires across 120+ countries',
      'Custom contract terms',
      '24/7 priority support SLA',
      'Support for ICs, EORs, and direct hires',
    ],
    extras: ['Access to global labor law advisory', 'Custom HRIS and ATS integrations'],
    dark: false,
  },
];
---

<section class="relative z-10 mx-auto mt-[120px] flex w-full max-w-[1224px] flex-col items-center gap-10 px-4">
  <h2 class="heading-gradient font-pixel w-full text-center text-[40px] uppercase leading-[0.9] sm:text-[52px] xl:text-[64px]">
    Ready to go further?
  </h2>

  <div class="flex w-full max-w-[816px] flex-col items-stretch gap-2 rounded-[28px] bg-[#171616] p-2 md:w-auto md:flex-row">
    {plans.map((plan) => (
      <div
        class:list={[
          'flex w-full max-w-[392px] items-center rounded-[24px] px-6 py-8 md:w-[392px]',
          plan.dark ? 'border-2 border-[#2c2a2a] bg-[#0a0400] text-white' : 'bg-white text-[#0a0400]',
        ]}
      >
        <div class="flex w-full flex-col gap-10">
          <div class="flex items-start justify-between">
            <p class="text-[32px] font-semibold leading-none tracking-[-0.96px]">{plan.name}</p>
            <p class="text-[32px] font-medium leading-[1.3] tracking-[-1.6px]">
              {plan.price}<span
                class:list={[
                  'relative top-[2px] ml-1 align-middle text-[12px] font-normal leading-[1.7] tracking-normal',
                  plan.dark ? 'text-[#9e9e9e]' : 'text-[#606060]',
                ]}>/month</span
              >
            </p>
          </div>

          <div class="flex flex-col gap-5">
            <div class="flex flex-col gap-4">
              <p class="text-[18px] font-medium leading-[1.5] tracking-[-0.36px]">Includes:</p>
              <ul class="flex flex-col gap-4">
                {plan.included.map((feature) => (
                  <li class="flex items-center gap-3">
                    <span
                      class:list={[
                        'flex shrink-0 items-center rounded-full p-1',
                        plan.dark ? 'bg-[rgba(255,149,45,0.3)] mix-blend-lighten' : 'bg-[rgba(0,0,0,0.15)]',
                      ]}
                    >
                      <span class="relative block size-4">
                        <img src="/images/pricing-check-circle.svg" alt="" class="absolute inset-0 size-full" />
                        <span class="absolute" style="inset: 23.29% 12.5% 20.83% 14.21%;">
                          <img
                            src={plan.dark ? '/images/pricing-tick-white.svg' : '/images/pricing-tick-black.svg'}
                            alt=""
                            class="block size-full"
                          />
                        </span>
                      </span>
                    </span>
                    <span class="text-[16px] leading-[1.7]">{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="flex w-full items-center gap-3">
              <img
                src={plan.dark ? '/images/pricing-line-dark.svg' : '/images/pricing-line-light.svg'}
                alt=""
                class="h-px min-w-px flex-1 mix-blend-hard-light"
              />
              <p
                class:list={[
                  'whitespace-nowrap text-center text-[12px] uppercase leading-[1.8] tracking-[1.8px]',
                  plan.dark ? 'text-[#dedddd]' : 'text-[#606060]',
                ]}
              >
                extra features from others
              </p>
              <img
                src={plan.dark ? '/images/pricing-line-dark.svg' : '/images/pricing-line-light.svg'}
                alt=""
                class="h-px min-w-px flex-1 mix-blend-hard-light"
              />
            </div>

            <ul class="flex flex-col gap-4">
              {plan.extras.map((feature) => (
                <li class="flex items-center gap-3">
                  <span
                    class:list={[
                      'flex shrink-0 items-center rounded-full p-1',
                      plan.dark ? 'bg-[rgba(255,149,45,0.3)] mix-blend-lighten' : 'bg-[rgba(0,0,0,0.15)]',
                    ]}
                  >
                    <span class="relative block size-4">
                      <img src="/images/pricing-check-circle.svg" alt="" class="absolute inset-0 size-full" />
                      <span class="absolute" style="inset: 23.29% 12.5% 20.83% 14.21%;">
                        <img
                          src={plan.dark ? '/images/pricing-tick-white.svg' : '/images/pricing-tick-black.svg'}
                          alt=""
                          class="block size-full"
                        />
                      </span>
                    </span>
                  </span>
                  <span class="text-[16px] leading-[1.7]">{feature}</span>
                </li>
              ))}
            </ul>
          </div>

          <a
            href="#start"
            class:list={['block w-full rounded-[16px] pb-1', plan.dark ? 'bg-[#bebdbd]' : 'bg-[#e77a00]']}
          >
            <span
              class:list={[
                'font-satoshi flex h-12 w-full items-center justify-center whitespace-nowrap rounded-[16px] px-6 text-[16px] font-bold leading-[22px] text-[#0a0a0a] transition-transform duration-100 active:translate-y-[2px]',
                plan.dark ? 'bg-white' : 'bg-[#ff952d]',
              ]}
            >
              Start free trial
            </span>
          </a>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .heading-gradient {
    background-image: linear-gradient(to bottom, #ffffff 0%, #0c0c0c 182%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>
