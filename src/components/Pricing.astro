---
// Figma node 14196:27219 (y6873, 1224x682): "Ready to go further?" gradient
// heading, then "Pricing Plans" — a #171616 pill (8px padding, 28px radius)
// holding two 392px plan cards: Monthly (bg #0a0400, 2px #2c2a2a border, white
// text, white 3D button) and Yearly (bg white, #0a0400 text, orange 3D button).
const plans = [
  {
    name: 'Monthly',
    price: '$9.99',
    included: [
      'Up to 5 active hires',
      'Hire from 1 supported country',
      'Standard contract generation',
      'Access to compliance updates',
    ],
    extras: ['Basic reporting dashboard', 'Onboarding guide & help center'],
    dark: true,
  },
  {
    name: 'Yearly',
    price: '$48',
    included: [
      'Unlimited hires across 120+ countries',
      'Custom contract terms',
      '24/7 priority support SLA',
      'Support for ICs, EORs, and direct hires',
    ],
    extras: ['Access to global labor law advisory', 'Custom HRIS and ATS integrations'],
    dark: false,
  },
];
---

<!-- Runs during parse, before the cards below are painted, so the off-screen
     start state only ever applies when JS is around to animate it back in. -->
<script is:inline>
  document.documentElement.classList.add('js-motion');
</script>

<section
  id="premium"
  aria-labelledby="pricing-heading"
  class="relative z-10 mx-auto mt-[120px] flex w-full max-w-[1224px] flex-col items-center gap-10 px-4"
>
  <h2
    id="pricing-heading"
    class="heading-gradient font-pixel w-full text-center text-[40px] uppercase leading-[0.9] sm:text-[52px] xl:text-[64px]"
  >
    Ready to go further?
  </h2>

  <!-- Monthly flies in from beyond the left edge and Yearly from the right, into
       the pill that already holds their slot; the page shell's overflow-x-clip absorbs the
       travel so neither one widens the page on the way in. -->
  <div
    id="pricing-plans"
    class="flex w-full max-w-[816px] flex-col items-stretch gap-2 rounded-[28px] bg-[#171616] p-2 light:border light:border-[#ececec] light:bg-[#f0f0f0] md:w-auto md:flex-row"
  >
    {plans.map((plan, i) => (
      <div
        class:list={[
          'reveal flex w-full max-w-[392px] items-center rounded-[24px] px-6 py-8 md:w-[392px]',
          i === 0 ? 'reveal-from-left' : 'reveal-from-right',
          plan.dark
            ? 'border-2 border-[#2c2a2a] bg-[#0a0400] text-white light:border-[#e9e9e9] light:bg-white light:text-[#1c1512]'
            : 'bg-white text-[#0a0400] light:border-2 light:border-[#2c2a2a] light:bg-[#0a0400] light:text-white',
        ]}
      >
        <div class="flex w-full flex-col gap-10">
          <div class="flex items-start justify-between">
            <h3 class="text-[32px] font-semibold leading-none tracking-[-0.96px]">{plan.name}</h3>
            <p class="text-[32px] font-medium leading-[1.3] tracking-[-1.6px]">
              {plan.price}<span
                class:list={[
                  'relative top-[2px] ml-1 align-middle text-[12px] font-normal leading-[1.7] tracking-normal',
                  plan.dark ? 'text-[#9e9e9e] light:text-[#737373]' : 'text-[#606060] light:text-[#9e9e9e]',
                ]}>/month</span
              >
            </p>
          </div>

          <div class="flex flex-col gap-5">
            <div class="flex flex-col gap-4">
              <p class="text-[18px] font-medium leading-[1.5] tracking-[-0.36px]">Includes:</p>
              <ul class="flex flex-col gap-4">
                {plan.included.map((feature) => (
                  <li class="flex items-center gap-3">
                    <span
                      class:list={[
                        'flex shrink-0 items-center rounded-full p-1',
                        plan.dark
                          ? 'bg-[rgba(255,149,45,0.3)] mix-blend-lighten light:bg-[rgba(255,149,45,0.5)] light:mix-blend-normal'
                          : 'bg-[rgba(0,0,0,0.15)] light:bg-[rgba(255,149,45,0.5)] light:mix-blend-lighten',
                      ]}
                    >
                      <span class="relative block size-4">
                        <img src="/images/pricing-check-circle.svg" alt="" class="absolute inset-0 size-full" />
                        <span class="absolute" style="inset: 23.29% 12.5% 20.83% 14.21%;">
                          <img
                            src={plan.dark ? '/images/pricing-tick-white.svg' : '/images/pricing-tick-black.svg'}
                            alt=""
                            class="block size-full light:invert"
                          />
                        </span>
                      </span>
                    </span>
                    <span class="text-[16px] leading-[1.7]">{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="flex w-full items-center gap-3">
              <img
                src={plan.dark ? '/images/pricing-line-dark.svg' : '/images/pricing-line-light.svg'}
                alt=""
                class:list={['h-px min-w-px flex-1 mix-blend-hard-light', !plan.dark && 'light:invert']}
              />
              <p
                class:list={[
                  'whitespace-nowrap text-center text-[12px] uppercase leading-[1.8] tracking-[1.8px]',
                  plan.dark ? 'text-[#dedddd] light:text-[#737373]' : 'text-[#606060] light:text-[#dedddd]',
                ]}
              >
                extra features from others
              </p>
              <img
                src={plan.dark ? '/images/pricing-line-dark.svg' : '/images/pricing-line-light.svg'}
                alt=""
                class:list={['h-px min-w-px flex-1 mix-blend-hard-light', !plan.dark && 'light:invert']}
              />
            </div>

            <ul class="flex flex-col gap-4">
              {plan.extras.map((feature) => (
                <li class="flex items-center gap-3">
                  <span
                    class:list={[
                      'flex shrink-0 items-center rounded-full p-1',
                      plan.dark
                        ? 'bg-[rgba(255,149,45,0.3)] mix-blend-lighten light:bg-[rgba(255,149,45,0.2)] light:mix-blend-normal'
                        : 'bg-[rgba(0,0,0,0.15)] light:bg-[rgba(255,149,45,0.3)] light:mix-blend-lighten',
                    ]}
                  >
                    <span class="relative block size-4">
                      <img src="/images/pricing-check-circle.svg" alt="" class="absolute inset-0 size-full" />
                      <span class="absolute" style="inset: 23.29% 12.5% 20.83% 14.21%;">
                        <img
                          src={plan.dark ? '/images/pricing-tick-white.svg' : '/images/pricing-tick-black.svg'}
                          alt=""
                          class="block size-full light:invert"
                        />
                      </span>
                    </span>
                  </span>
                  <span class="text-[16px] leading-[1.7]">{feature}</span>
                </li>
              ))}
            </ul>
          </div>

          <a
            href="#start"
            class:list={[
              'cta-3d block w-full rounded-[16px] pb-1',
              plan.dark ? 'bg-[#bebdbd] light:bg-[#d4d4d4]' : 'bg-[#e77a00]',
            ]}
          >
            <span
              class:list={[
                'font-satoshi flex h-12 w-full items-center justify-center whitespace-nowrap rounded-[16px] px-6 text-[16px] font-bold leading-[22px] text-[#0a0a0a] transition-transform duration-100 active:translate-y-[2px]',
                plan.dark ? 'bg-white light:border light:border-[#1c1512] light:bg-white' : 'bg-[#ff952d]',
              ]}
            >
              Start free trial
            </span>
          </a>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  /* Both plan CTAs rock gently around their own midpoint: the center stays put
     while the two ends rise and fall in opposition. A rotation is what keeps the
     center genuinely fixed — the origin is the pivot, so only the sides travel,
     and the further from center the more they move.

     The tilt is deliberately tiny (0.9deg). On the 392px card that works out to
     roughly 3px of rise at each end, which is the same order as the button's own
     3D base — enough to read as motion, small enough not to look broken. The
     animation lives on the anchor rather than the face so the button and the
     base it sits on tilt as one piece. */
  .cta-3d {
    transform-origin: center;
    animation: cta-wave 1.1s ease-in-out infinite;
  }

  /* Hand the button back to the pointer once it's actually being used, so the
     press reads as a press rather than landing mid-tilt. The face's
     active:translate-y is a separate element and property, so it never fights
     this rotation. */
  .cta-3d:hover,
  .cta-3d:focus-visible {
    animation-play-state: paused;
  }

  @keyframes cta-wave {
    0%,
    100% {
      transform: rotate(-0.9deg);
    }
    50% {
      transform: rotate(0.9deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-3d {
      animation: none;
    }
  }

  /* Start just past the viewport edge: half the screen plus half the card's own
     width clears it at every breakpoint, single-column mobile included. */
  .reveal-from-left {
    --reveal-from: translateX(calc(-50vw - 50%));
  }

  .reveal-from-right {
    --reveal-from: translateX(calc(50vw + 50%));
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js-motion) .reveal {
      opacity: 0;
      transform: var(--reveal-from);
    }

    /* Transition lives on the end state so the cards ease in once and never
       animate back out. Both sides share the timing, so they meet in the
       middle rather than one arriving ahead of the other. */
    :global(html.js-motion) .reveal.is-revealed {
      opacity: 1;
      transform: none;
      transition:
        transform 1.4s cubic-bezier(0.33, 0.02, 0.24, 1),
        opacity 0.8s ease-out;
    }
  }
</style>

<script>
  const plans = document.getElementById('pricing-plans');
  const cards = plans ? Array.from(plans.querySelectorAll<HTMLElement>('.reveal')) : [];

  if (plans && cards.length) {
    const land = () => cards.forEach((card) => card.classList.add('is-revealed'));

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      land();
    } else {
      // Two frames of daylight between the off-screen start state and the class
      // that transitions out of it. Without this, a reload that restores the
      // scroll position onto this section hands the observer an already-visible
      // target, its first callback lands in the same style pass as the initial
      // paint, and the browser has no earlier value to transition from — the
      // cards just appear. One rAF is not always enough; two guarantees the
      // start state has been painted.
      const reveal = () => requestAnimationFrame(() => requestAnimationFrame(land));

      // Waits until a slice of the pill is genuinely on screen. Triggering
      // early (while it is still below the fold) burns the glide on scenery
      // nobody can see, so a quick scroll past would show only the tail of it.
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            observer.disconnect();
            reveal();
          });
        },
        { threshold: 0.15 }
      );

      observer.observe(plans);
    }
  }
</script>


