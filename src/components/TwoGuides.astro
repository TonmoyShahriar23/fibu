---
// Figma nodes: 14196:27218 (heading, y3863), 14196:14257 (Illustration 1 at
// x380/y4138, 665x600), 14196:27722 (Fibu card, x108/y4161, 312x239),
// 14196:27725 (Grandma card, x1020/y3971, 312x289). Section spans y3863-4738
// (875px tall), 208px below the solution cards. Desktop uses the exact Figma
// absolute offsets inside the 1224px content box; below xl it stacks.
const fibu = {
  name: 'Fibu',
  body: "Fibu is the friend who dares you to hit 'start.' Every streak, every level-up, every badge that's fibu cheering the loudest.",
};

// Same shape as fibu above: the typing script reads each line's full text from
// the card, so the copy has to live somewhere it can be emitted as one run of
// characters rather than as wrapped source.
const grandma = {
  name: 'Grandma',
  body: "Grandma is the one who reminds you there's no such thing as behind only next. Broke your streak? Missed a week? Grandma's not disappointed. She's just glad you're back.",
};
---

<!-- `js-motion` (the flag that hides the untyped tail below) is set in Layout's
     head script, ahead of any of this being painted. -->
<section
  id="guides"
  aria-labelledby="guides-heading"
  class="relative z-10 mx-auto mt-[120px] w-full max-w-[1224px] px-4 xl:mt-[208px]"
>
  <div class="relative flex flex-col items-center gap-10 xl:block xl:h-[875px]">
    <h2
      id="guides-heading"
      class="heading-gradient font-pixel mx-auto max-w-[458px] text-center text-[40px] uppercase leading-[0.9] sm:text-[52px] xl:text-[64px]"
    >
      You get two guides. Not just an app.
    </h2>

    <img
      src="/images/guides-illustration.png"
      alt="Fibu the fox waving a flag beside Grandma holding a balloon"
      class="w-full max-w-[500px] xl:absolute xl:left-[272px] xl:top-[275px] xl:w-[665px] xl:max-w-none"
      width="665"
      height="600"
      loading="lazy"
      decoding="async"
    />

    <!-- Fibu introduces himself on a loop: name, then body, one character at a
         time, then it clears and starts over. Every character is in the DOM
         from the start — the untyped tail is merely transparent — so the lines
         wrap where they always would and the card never resizes as it types.
         The spans have to stay on one line: a newline between them would
         render as a stray space mid-sentence. -->
    <div id="fibu-card" class="guide-card guide-card-fibu xl:absolute xl:left-0 xl:top-[298px]">
      <h3
        class="type-line text-[20px] font-medium leading-[1.25] tracking-[-0.2px] text-white light:text-[#1c1512]"
      ><span class="type-typed"></span><span class="type-caret" aria-hidden="true"></span><span class="type-rest">{fibu.name}</span></h3>
      <p
        class="type-line font-fira text-[18px] leading-[1.4] text-white light:text-[#3f3f3f]"
      ><span class="type-typed"></span><span class="type-caret" aria-hidden="true"></span><span class="type-rest">{fibu.body}</span></p>
    </div>

    <!-- Grandma types herself in the same way, on her own trigger — same spans,
         same classes, same script. The one-line rule above applies here too: a
         newline between these spans would render as a stray space mid-sentence. -->
    <div id="grandma-card" class="guide-card guide-card-grandma xl:absolute xl:right-0 xl:top-[108px]">
      <h3
        class="type-line text-[20px] font-medium leading-[1.25] tracking-[-0.2px] text-white light:text-[#1c1512]"
      ><span class="type-typed"></span><span class="type-caret" aria-hidden="true"></span><span class="type-rest">{grandma.name}</span></h3>
      <p
        class="type-line font-fira text-[18px] leading-[1.4] text-white light:text-[#3f3f3f]"
      ><span class="type-typed"></span><span class="type-caret" aria-hidden="true"></span><span class="type-rest">{grandma.body}</span></p>
    </div>
  </div>
</section>

<style>
  .guide-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
    max-width: 312px;
    overflow: clip;
    border-radius: 24px;
    border: 1px solid rgba(204, 97, 0, 0.2);
    padding: 24px;
  }

  .guide-card-fibu {
    background-image: var(--guide-grad-fibu);
  }

  .guide-card-grandma {
    background-image: var(--guide-grad-grandma);
  }

  /* Zero net width — the 2px bar is cancelled by the negative margin — so the
     caret can sit between the typed text and the tail without nudging a single
     character or changing where the line wraps. */
  .type-caret {
    display: none;
    width: 2px;
    height: 1em;
    margin-right: -2px;
    vertical-align: -0.15em;
    background: currentColor;
  }

  /* Square wave rather than a fade: a terminal caret snaps on and off. Its
     rhythm is independent of the typing, so it blinks through the pauses. */
  @keyframes type-caret-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Only ever hidden while JS is there to type it back in — with the script
       gone (or motion turned down) the card renders in full, as written. */
    :global(html.js-motion) .type-rest {
      color: transparent;
    }

    /* Shown on whichever line is being typed, then handed to the next. */
    .type-caret.is-active {
      display: inline-block;
      animation: type-caret-blink 1.06s step-end infinite;
    }
  }
</style>

<script>
  // Each guide card types itself out, line after line, once — then it stays put.
  // Both cards run this same routine; a card opts in purely by holding
  // `.type-line` rows, and each gets its own observer so it starts when it is
  // itself on screen rather than when its neighbour is. They sit at different
  // heights on desktop, so they are rarely in view at the same moment.
  const CPS = 13; // characters a second — deliberate, one key at a time

  const readLines = (card: HTMLElement) =>
    Array.from(card.querySelectorAll<HTMLElement>('.type-line'))
      .map((line) => ({
        typed: line.querySelector<HTMLElement>('.type-typed'),
        caret: line.querySelector<HTMLElement>('.type-caret'),
        rest: line.querySelector<HTMLElement>('.type-rest'),
      }))
      .filter((line) => line.typed && line.caret && line.rest)
      .map((line) => ({
        typed: line.typed!,
        caret: line.caret!,
        rest: line.rest!,
        text: line.rest!.textContent ?? '',
      }));

  type Line = ReturnType<typeof readLines>[number];

  // Driven off the clock rather than a per-frame step, so the pace holds on a
  // 120Hz screen and on a tab dropping frames alike.
  const type = (lines: Line[], index: number) => {
    const line = lines[index];
    if (!line) return;

    line.caret.classList.add('is-active');
    const start = performance.now();

    const step = (now: number) => {
      const shown = Math.min(line.text.length, Math.round(((now - start) / 1000) * CPS));
      line.typed.textContent = line.text.slice(0, shown);
      line.rest.textContent = line.text.slice(shown);

      if (shown < line.text.length) {
        requestAnimationFrame(step);
        return;
      }

      line.caret.classList.remove('is-active');
      type(lines, index + 1);
    };

    requestAnimationFrame(step);
  };

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    for (const card of document.querySelectorAll<HTMLElement>('.guide-card')) {
      const lines = readLines(card);
      if (!lines.length) continue;

      // Starts the pass once this card is properly on screen, so it isn't
      // already finished by the time anyone scrolls to it. One observer per
      // card, disconnected on its own arrival.
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            observer.disconnect();
            type(lines, 0);
          });
        },
        { threshold: 0.45 }
      );

      observer.observe(card);
    }
  }
</script>
