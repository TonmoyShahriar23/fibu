---
// Figma nodes 14219:646 (background band: #171616, 40px top radii, starts 80px
// behind the CTA card's bottom edge) and 14219:647 (content, 1224x436 at 160px
// below the band top). Logo is the navbar branding at 1.5x (144x72) — same
// local assets, scaled mask. Small store badges are the hero assets at 40px.
const columns = [
  { title: 'Navigation', links: ['Features', 'How it works', 'Pricing', 'Integration'] },
  { title: 'Resources', links: ['Terms & privacy', 'Privacy', 'Changelog'] },
  { title: 'Miscellineous', links: ['Insights', 'Abouts'] },
  { title: 'Company', links: ['Careers', 'Contact', 'FAQs'] },
];
---

<footer class="relative z-0 -mt-[80px] w-full rounded-t-[40px] bg-[#171616] light:bg-[#f6f6f6]">
  <div class="mx-auto flex w-full max-w-[1224px] flex-col gap-16 px-4 pb-12 pt-[100px] lg:gap-[120px] lg:pb-[48px] lg:pt-[160px]">
    <!-- upper -->
    <div class="flex flex-col gap-12 lg:flex-row lg:items-start lg:justify-between">
      <div class="flex flex-col gap-12">
        <div class="flex flex-col gap-10">
          <a href="/" class="relative block h-[72px] w-[144px] overflow-clip" aria-label="Fibu — home">
            <span class="absolute" style="inset: -7.6% 55.06% 8.86% -4.43%;">
              <img src="/images/logo-fox-outline.svg" alt="" class="block size-full" loading="lazy" />
            </span>
            <span
              class="absolute"
              style="inset: 3.69% 63.13% -11.79% 3.66%; mask-image: url('/images/logo-fox-mask.svg'); -webkit-mask-image: url('/images/logo-fox-mask.svg'); mask-mode: alpha; mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: -15.301px -14.962px; -webkit-mask-position: -15.301px -14.962px; mask-size: 77.957px 77.924px; -webkit-mask-size: 77.957px 77.924px;"
            >
              <img src="/images/logo-fox-fill.svg" alt="" class="block size-full" loading="lazy" />
            </span>
            <span class="absolute" style="inset: 38.55% 0 16.11% 41.02%;">
              <img src="/images/logo-wordmark.svg" alt="" class="block size-full transition-[filter] duration-300 light:brightness-0" loading="lazy" />
            </span>
          </a>

          {/* The glyphs stay 20px; each link is a 44px box around one so the tap
              target clears the 24px minimum. The inner span keeps `relative
              overflow-clip` so the percentage insets below still resolve against
              a 20x20 box, exactly as they did when the anchor carried them. */}
          <div class="flex items-start gap-2 transition-[filter] duration-300">
            <a href="#x" aria-label="Fibu on X" class="flex size-11 items-center justify-center transition-opacity hover:opacity-70 light:brightness-0">
              <span class="relative block size-5 overflow-clip">
                <span class="absolute" style="inset: 7.93% 4.17% 9.21% 4.17%;">
                  <img src="/images/social-x.svg" alt="" class="block size-full" loading="lazy" />
                </span>
              </span>
            </a>
            <a href="#instagram" aria-label="Fibu on Instagram" class="flex size-11 items-center justify-center transition-opacity hover:opacity-70 light:brightness-0">
              <span class="relative block size-5 overflow-clip">
                <span class="absolute" style="inset: 0 0.06% 0.02% 0;">
                  <img src="/images/social-instagram-1.svg" alt="" class="block size-full" loading="lazy" />
                </span>
                <span class="absolute" style="inset: 24.32%;">
                  <img src="/images/social-instagram-2.svg" alt="" class="block size-full" loading="lazy" />
                </span>
                <span class="absolute" style="inset: 17.3% 17.3% 70.7% 70.7%;">
                  <img src="/images/social-instagram-3.svg" alt="" class="block size-full" loading="lazy" />
                </span>
              </span>
            </a>
            <a href="#linkedin" aria-label="Fibu on LinkedIn" class="flex size-11 items-center justify-center transition-opacity hover:opacity-70">
              <span class="block size-5 overflow-clip">
                <img src="/images/social-linkedin.svg" alt="" class="block size-full" loading="lazy" />
              </span>
            </a>
            <a href="#threads" aria-label="Fibu on Threads" class="flex size-11 items-center justify-center transition-opacity hover:opacity-70 light:brightness-0">
              <span class="relative block size-5 overflow-clip">
                <span class="absolute" style="inset: 0 7.2% 0 6.77%;">
                  <img src="/images/social-threads.svg" alt="" class="block size-full" loading="lazy" />
                </span>
              </span>
            </a>
          </div>
        </div>

        <div class="flex items-center gap-6">
          <p class="font-geist w-[100px] text-[14px] leading-[1.5] tracking-[-0.2px] text-white opacity-80 light:text-[#1c1512]">
            Golden Partner Award
          </p>
          <div class="flex items-center gap-[23px]">
            <img src="/images/award-badge-1.png" alt="Easiest to do business with award badge" class="h-14 w-[47px] object-cover" loading="lazy" />
            <img src="/images/award-badge-2.png" alt="CRM Leader award badge" class="h-14 w-[47px] object-cover" loading="lazy" />
          </div>
        </div>
      </div>

      <nav
        aria-label="Footer"
        class="grid grid-cols-2 gap-8 text-[16px] text-white light:text-[#1c1512] sm:grid-cols-4 lg:flex lg:gap-14"
      >
        {columns.map((col) => (
          <div class="flex flex-col gap-4">
            <h2 class="font-geist w-[136px] font-medium leading-[1.65] tracking-[-0.32px]">{col.title}</h2>
            {/* `block w-fit py-1` lifts each link's tap target from 20px to 34px
                without widening it past its text; the list gap drops to 0 so the
                visual rhythm between rows is unchanged. */}
            <ul class="flex flex-col leading-[1.6] tracking-[-0.16px]">
              {col.links.map((link) => (
                <li>
                  <a href="#" class="block w-fit py-1 opacity-70 transition-opacity hover:opacity-100">{link}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <!-- lower -->
    <div class="flex flex-wrap items-center gap-x-[26px] gap-y-6">
      <p class="whitespace-nowrap text-[16px] leading-[1.6] tracking-[-0.16px] text-white opacity-50 light:text-[#1c1512]">
        © Fibu.dev 2026 - All Right Reserved
      </p>
      <img src="/images/footer-divider.svg" alt="" class="hidden h-px min-w-px flex-1 light:brightness-0 light:opacity-30 lg:block" aria-hidden="true" />
      <div class="flex flex-wrap items-center gap-4">
        <p class="whitespace-nowrap text-[16px] leading-[1.6] tracking-[-0.16px] text-white opacity-70 light:text-[#1c1512]">
          Install on your device
        </p>
        <div class="flex items-center gap-2">
          <a
            href="#google-play"
            class="relative block h-10 w-[135px] overflow-clip rounded-[5px] border border-[#a6a6a6] bg-white transition-transform hover:scale-[1.03]"
            aria-label="Get it on Google Play"
          >
            <span class="absolute" style="left: 8.97px; top: 6.5px; width: 23.09px; height: 27px;">
              <img src="/images/badge-google-play-logo.svg" alt="" class="block size-full" loading="lazy" />
            </span>
            <span class="absolute" style="left: 40.35px; top: 6.2px; width: 38.848px; height: 6.59px;">
              <img src="/images/badge-get-it-on.svg" alt="" class="block size-full" loading="lazy" />
            </span>
            <span class="absolute" style="left: 40.04px; top: 16.9px; width: 84.776px; height: 17.88px;">
              <img src="/images/badge-google-play-text.svg" alt="" class="block size-full" loading="lazy" />
            </span>
          </a>
          <a
            href="#app-store"
            class="relative block h-10 w-[120px] rounded-[7px] border border-[#a6a6a6] bg-white transition-transform hover:scale-[1.03]"
            aria-label="Download on the App Store"
          >
            <span class="absolute" style="left: 8.97px; top: 8.16px; width: 17.717px; height: 22.86px;">
              <img src="/images/badge-apple-logo.svg" alt="" class="block size-full" loading="lazy" />
            </span>
            <span class="absolute" style="left: 34.65px; top: 7.84px; width: 69.151px; height: 6.69px;">
              <img src="/images/badge-download-on-the.svg" alt="" class="block size-full" loading="lazy" />
            </span>
            <span class="absolute" style="left: 33.45px; top: 17.66px; width: 75.076px; height: 16.51px;">
              <img src="/images/badge-app-store-text.svg" alt="" class="block size-full" loading="lazy" />
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
