---
// "More From Fibu Insights" row from Figma 14544:1170 — a 64px pixel heading over
// three of the same blog cards the listing uses (nodes 14552:623/633/643), on the
// 1224px content column with 24px gutters.
//
// The design hard-codes the first three posts, which means the card for the
// article you are already reading appears in its own "more from" row. Here the
// current post is filtered out and the next three in order are shown instead, so
// the row never links back to the current page.
import BlogCard from './BlogCard.astro';
import { posts } from '../data/posts';

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;

const index = posts.findIndex((post) => post.slug === currentSlug);
const rotated = [...posts.slice(index + 1), ...posts.slice(0, Math.max(index, 0))];
const related = rotated.slice(0, 3);
---

<section aria-labelledby="more-insights-heading" class="relative z-10 mx-auto mt-[120px] w-full max-w-[1224px] px-4">
  <h2
    id="more-insights-heading"
    class="heading-gradient font-pixel text-center text-[40px] uppercase leading-[0.9] sm:text-[52px] xl:text-[64px]"
  >
    More From Fibu Insights
  </h2>

  <ul class="mt-12 grid list-none grid-cols-1 gap-6 p-0 md:grid-cols-2 lg:grid-cols-3">
    {related.map((post) => <BlogCard post={post} />)}
  </ul>
</section>
