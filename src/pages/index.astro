---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import PhoneMockup from '../components/PhoneMockup.astro';
import Stats from '../components/Stats.astro';
import ProblemSolution from '../components/ProblemSolution.astro';
import TwoGuides from '../components/TwoGuides.astro';
import StepsSection from '../components/StepsSection.astro';
import Testimonials from '../components/Testimonials.astro';
import Pricing from '../components/Pricing.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Fibu — Learn to Code, 15 Minutes at a Time">
  <main class="relative min-h-screen overflow-x-clip bg-black text-white">
    <Navbar />
    <Hero />
    <PhoneMockup />
    <Stats />
    <ProblemSolution />
    <TwoGuides />
    <StepsSection />
    <Testimonials />
    <Pricing />
    <FAQ />
    <FinalCTA />
    <Footer />
  </main>
</Layout>
