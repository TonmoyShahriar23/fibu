---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PostHero from '../../components/blog/PostHero.astro';
import BlogContent from '../../components/blog/BlogContent.astro';
import MoreFromInsights from '../../components/blog/MoreFromInsights.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import Footer from '../../components/Footer.astro';
import {
  getAllPublishedBlogs,
  getBlogBySlug,
  authorName,
  formatDate,
  postDate,
  type Blog,
} from '../../lib/blog';
import { excerptFor } from '../../lib/content';

/** Stand-ins from the Figma frame, used when the API supplies neither. */
const FALLBACK_HERO = '/images/post-hero.png';
const FALLBACK_AVATAR = '/images/post-author.png';

export const getStaticPaths = (async () => {
  const listed = await getAllPublishedBlogs();

  // The list endpoint already returns full rows, but the detail endpoint is the
  // contract for a single post — fetching through it keeps this page rendering
  // exactly what /api/blogs/slug/:slug serves. Responses are memoised in
  // lib/blog.ts, so this costs one request per post.
  const fetched = await Promise.all(
    listed.map(async (summary) => {
      const post = await getBlogBySlug(summary.slug);

      if (!post) {
        // One unavailable post must not take the whole build down with it.
        console.warn(`[blog] skipping /blog/${summary.slug} — detail fetch failed`);
        return null;
      }

      return post;
    }),
  );

  const posts = fetched.filter((post): post is Blog => post !== null);

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, siblings: posts },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Blog;
  siblings: Blog[];
}

const { post, siblings } = Astro.props;

const site = Astro.site;
const abs = (path: string) => (site ? new URL(path, site).href : path);

const iso = postDate(post);
const dateLabel = formatDate(iso);
const author = authorName(post);
const heroImage = post.featuredImage?.trim() || FALLBACK_HERO;
const avatar = post.author?.avatarUrl?.trim() || FALLBACK_AVATAR;

const description = post.metaDescription?.trim() || excerptFor(post, 155) || `${post.title} — from the Fibu blog.`;

const postSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${site?.origin ?? ''}/blog/${post.slug}#post`,
  headline: post.title,
  description,
  url: abs(`/blog/${post.slug}`),
  image: heroImage.startsWith('http') ? heroImage : abs(heroImage),
  datePublished: iso ?? undefined,
  dateModified: post.updatedAt ?? iso ?? undefined,
  inLanguage: 'en',
  author: { '@type': 'Person', name: author },
  publisher: { '@id': `${site?.origin ?? ''}/#organization` },
  isPartOf: { '@id': `${site?.origin ?? ''}/blog#blog` },
  mainEntityOfPage: abs(`/blog/${post.slug}`),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: abs('/blog') },
    { '@type': 'ListItem', position: 3, name: post.title, item: abs(`/blog/${post.slug}`) },
  ],
};
---

<Layout title={`${post.metaTitle?.trim() || post.title} — Fibu`} description={description} image={heroImage}>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-[12px] focus:bg-[#ff952d] focus:px-4 focus:py-2 focus:text-[16px] focus:font-bold focus:text-[#0a0a0a]"
  >
    Skip to main content
  </a>

  <!-- Positioning context for the hero backdrop, which is absolutely placed
       against the page shell. The <header> and <footer> sit outside <main> so the
       page exposes proper banner / main / contentinfo landmarks. -->
  <div class="relative min-h-screen overflow-x-clip bg-black text-white light:bg-white light:text-[#1c1512]">
    <!-- The navbar overlays the hero photo, so it needs to sit above it. -->
    <div class="relative z-20">
      <Navbar />
    </div>

    <main id="main" tabindex="-1" class="-mt-[105px]">
      <article>
        <PostHero
          title={post.title}
          dateIso={iso}
          dateLabel={dateLabel}
          author={author}
          authorAvatar={avatar}
          image={heroImage}
        />

        <!-- 808px reading column, per Figma 14547:32136. -->
        <div class="mx-auto mt-16 w-full max-w-[808px] px-4 sm:mt-20">
          <BlogContent content={post.content} />
        </div>
      </article>

      <MoreFromInsights posts={siblings} currentSlug={post.slug} />
      <FinalCTA />
    </main>
    <Footer />
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(postSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Layout>
