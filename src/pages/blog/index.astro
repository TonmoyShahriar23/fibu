---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import BlogHero from '../../components/blog/BlogHero.astro';
import BlogListSection from '../../components/blog/BlogListSection.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import Footer from '../../components/Footer.astro';
import { getBlogs, POSTS_PER_PAGE } from '../../lib/blog';

// Page 1 of the listing. Pages 2+ live at /blog/page/[page] and render the same
// section component. getBlogs swallows API failures and returns an empty result,
// so a backend outage degrades to the empty state instead of failing the build.
const { data: posts, total } = await getBlogs({
  skip: 0,
  take: POSTS_PER_PAGE,
  isPublished: true,
  orderBy: 'publishedAt',
  orderDirection: 'desc',
});

const site = Astro.site;
const abs = (path: string) => (site ? new URL(path, site).href : path);

const title = 'Blog & Insights — Fibu';
const description =
  'Practical guides on building a coding habit that lasts: how to learn faster, stay motivated, and turn what you know into real-world skills.';

const blogSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Blog',
      '@id': `${site?.origin ?? ''}/blog#blog`,
      name: 'Fibu Blog & Insights',
      url: abs('/blog'),
      description,
      inLanguage: 'en',
      publisher: { '@id': `${site?.origin ?? ''}/#organization` },
      blogPost: posts.map((post) => ({
        '@type': 'BlogPosting',
        '@id': `${site?.origin ?? ''}/blog/${post.slug}#post`,
        headline: post.title,
        url: abs(`/blog/${post.slug}`),
        datePublished: post.publishedAt ?? post.createdAt,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: abs('/blog') },
      ],
    },
  ],
};
---

<Layout title={title} description={description}>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-[12px] focus:bg-[#ff952d] focus:px-4 focus:py-2 focus:text-[16px] focus:font-bold focus:text-[#0a0a0a]"
  >
    Skip to main content
  </a>

  <!-- Positioning context for the hero band, which is absolutely placed against
       the page shell. The <header> and <footer> sit outside <main> so the page
       exposes proper banner / main / contentinfo landmarks. -->
  <div class="relative min-h-screen overflow-x-clip bg-black text-white light:bg-white light:text-[#1c1512]">
    <Navbar />
    <main id="main" tabindex="-1">
      <BlogHero />
      <BlogListSection posts={posts} total={total} page={1} perPage={POSTS_PER_PAGE} />
      <FinalCTA />
    </main>
    <Footer />
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(blogSchema)} />
</Layout>
